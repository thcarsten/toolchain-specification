pipeline generator/resources/rdfc-docker/

# IDE's
.vscode/

# Python build and cache artifacts.
#
# __pycache__ and *.egg-info were previously tracked, which meant that
# merely running the code (or the test suite) dirtied the working tree
# and produced spurious diffs in every branch. They are regenerated on
# import, so there is nothing to preserve.
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# Virtual environments.
.venv/
venv/

# Local environments
.env

# Jupyter
.ipynb_checkpoints/

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
_pytest_fixes.log
test_output.txt
pytest_results.txt

# Claude Code
.claude/settings.local.json

# Generator output. Everything materialized into an `out/` folder is
# scratch, safe to delete at any time. The one tracked, reviewable build
# lives in `pipeline generator/reference/` and is refreshed by promoting
# a run on purpose -- see the generator README.
**/out/

