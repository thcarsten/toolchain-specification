@base <file:///workspace/pipeline/> .
@prefix : <http://example.org/example/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfc: <https://w3id.org/rdf-connect#> .
@prefix tcs: <https://w3id.org/toolchain#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<> a rdfc:Pipeline ;
    owl:imports <file:///usr/local/lib/python3.13/site-packages/rdfc_http_in/processor.ttl>,
        <file:///usr/local/lib/python3.13/site-packages/rdfc_threshold_monitoring/processor.ttl>,
        <node_modules/@rdfc/sparql-ingest-processor-ts/processors.ttl> ;
    rdfc:consistsOf :env_1,
        :env_2 .

:HttpIn a rdfc:HttpIn ;
    rdfc:writer :channel_5 .

:SparqlIngest a rdfc:SparqlIngest ;
    rdfc:ingestConfig [ rdfc:operationMode "Replication" ] ;
    rdfc:memberStream :channel_6 .

:ThresholdMonitoring a rdfc:thresholdMonitoringProcessor ;
    rdfc:reader :channel_5 ;
    rdfc:unit <http://qudt.org/vocab/unit/CentiM> ;
    rdfc:value 30 ;
    rdfc:writer :channel_6 .

:env_1 rdfc:instantiates rdfc:PyRunner ;
    rdfc:processor :HttpIn .

:env_2 rdfc:instantiates rdfc:NodeRunner ;
    rdfc:processor :SparqlIngest,
        :ThresholdMonitoring .

:channel_5 a rdfc:Reader,
        rdfc:Writer,
        tcs:Channel .

:channel_6 a rdfc:Reader,
        rdfc:Writer,
        tcs:Channel .

