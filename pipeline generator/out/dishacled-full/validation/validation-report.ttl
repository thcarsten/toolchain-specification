    tcs:forChannel demo:sdsViolationsMeta ;
    tcs:inputShape :nodeshape_48 ;
    tcs:matches "unknown" ;
    tcs:outputShape :emptyshape_23 .

:throughputresult_3 a tcs:ThroughputMatchResult ;
    tcs:forChannel demo:sdsViolations ;
    tcs:inputShape :nodeshape_48 ;
    tcs:matches "unknown" ;
    tcs:outputShape :emptyshape_21 .

:throughputresult_4 a tcs:ThroughputMatchResult ;
    tcs:forChannel :channel_35 ;
    tcs:inputShape :nodeshape_51 ;
    tcs:matches "unknown" ;
    tcs:outputShape :emptyshape_13 .

:throughputresult_5 a tcs:ThroughputMatchResult ;
    tcs:forChannel :channel_64 ;
    tcs:inputShape demo:SosaWaterLevelObservationShape ;
    tcs:matches "unknown" ;
    tcs:outputShape demo:SosaWaterLevelObservationShape .

:throughputresult_6 a tcs:ThroughputMatchResult ;
    tcs:forChannel :channel_68 ;
    tcs:inputShape demo:SosaWaterLevelObservationShape ;
    tcs:matches "unknown" ;
    tcs:outputShape demo:SosaWaterLevelObservationShape .

:throughputresult_7 a tcs:ThroughputMatchResult ;
    tcs:forChannel :channel_58 ;
    tcs:inputShape demo:WaterLevelPropertyValueShape ;
    tcs:matches "unknown" ;
    tcs:outputShape demo:WaterLevelPropertyValueShape .

:throughputresult_8 a tcs:ThroughputMatchResult ;
