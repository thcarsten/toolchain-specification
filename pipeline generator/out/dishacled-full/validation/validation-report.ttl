@base <file:///workspace/pipeline/> .
@prefix : <http://example.org/example/> .
@prefix demo: <http://example.org/example/demonstrator/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tcs: <https://w3id.org/toolchain#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:throughputresult_0 a tcs:ThroughputMatchResult ;
    tcs:forChannel :channel_32 ;
    tcs:inputShape :emptyshape_0 ;
    tcs:matches "unknown" ;
    tcs:outputShape :nodeshape_9 .

:throughputresult_1 a tcs:ThroughputMatchResult ;
    tcs:forChannel :channel_13 ;
    tcs:inputShape demo:SosaWaterLevelObservationShape ;
    tcs:matches "unknown" ;
    tcs:outputShape demo:SosaWaterLevelObservationShape .

