        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nifi:dataDestinationFormat ;
        sh:name "Data destination format" ;
        nifi:propertyName "DATA_DESTINATION_FORMAT" ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nifi:memberRdfSyntaxType ;
        sh:name "IRIs to member RDF syntax type" ;
