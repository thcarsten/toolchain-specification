        nifi:propertyName "DELIMITER" ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nifi:versionOfKey ;
        sh:name "VersionOf Property" ;
        nifi:propertyName "VERSION_OF_KEY" ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nifi:dataInputFormat ;
        sh:name "Data input format" ;
        nifi:propertyName "DATA_INPUT_FORMAT" ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nifi:AzureStorageCredentialsControllerService_v12
    a tcs:PipelineComponent, dcat:Resource ;
    rdfs:label "Apache NiFi Azure Storage Credentials Controller Service v12" ;
    nifi:controllerServiceType "org.apache.nifi.services.azure.storage.AzureStorageCredentialsControllerService_v12" ;
    nifi:bundleGroup "org.apache.nifi" ;
    nifi:bundleArtifact "nifi-azure-nar" ;
    nifi:bundleVersion "2.10.0" ;
    nifi:serviceApiType "org.apache.nifi.services.azure.storage.AzureStorageCredentialsService_v12" ;
    nifi:serviceApiBundleGroup "org.apache.nifi" ;
    nifi:serviceApiBundleArtifact "nifi-azure-services-api-nar" ;
    nifi:serviceApiBundleVersion "2.10.0" ;
    dct:requires nifi:Orchestrator ;
    dcat:qualifiedRelation [
        a dcat:Relationship ;
        dcat:hadRole "configShape" ;
        dct:relation :NifiAzureStorageCredentialsConfigShape
    ] .

:NifiAzureStorageCredentialsConfigShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:prefixes :prefixes ;
        sh:select """
            SELECT ?this WHERE {
                ?service
                    prov:specializationOf nifi:AzureStorageCredentialsControllerService_v12 ;
                    p-plan:hasInputVar/tcs:embedded ?this .
            }
        """
    ] ;
    sh:property [
        sh:path nifi:credentialsType ;
        sh:name "Credentials Type" ;
        nifi:propertyName "Credentials Type" ;
        sh:datatype xsd:string ;
        sh:in ("ACCOUNT_KEY" "SAS_TOKEN" "MANAGED_IDENTITY" "SERVICE_PRINCIPAL" "IDENTITY_FEDERATION") ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nifi:endpointSuffix ;
        sh:name "Endpoint Suffix" ;
        nifi:propertyName "Endpoint Suffix" ;
        sh:datatype xsd:string ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nifi:storageAccountName ;
        sh:name "Storage Account Name" ;
        nifi:propertyName "Storage Account Name" ;
        nifi:sensitive true ;
        sh:datatype xsd:string ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nifi:accountKey ;
        sh:name "Account Key" ;
        nifi:propertyName "Account Key" ;
        nifi:sensitive true ;
        sh:datatype xsd:string ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nifi:sasToken ;
        sh:name "SAS Token" ;
        nifi:propertyName "SAS Token" ;
        nifi:sensitive true ;
        sh:datatype xsd:string ;
        sh:maxCount 1
    ] .

nifi:Funnel
    a tcs:PipelineComponent, dcat:Resource ;
    rdfs:label "Apache NiFi Funnel" ;
    nifi:componentType "FUNNEL" ;
    dct:requires nifi:Orchestrator .

nifi:InvokeHTTP
    a tcs:PipelineComponent, dcat:Resource ;
    rdfs:label "Apache NiFi InvokeHTTP" ;
    nifi:processorType "org.apache.nifi.processors.standard.InvokeHTTP" ;
    nifi:bundleGroup "org.apache.nifi" ;
    nifi:bundleArtifact "nifi-standard-nar" ;
    nifi:bundleVersion "2.10.0" ;
    nifi:outgoingRelationship "Response" ;
    nifi:autoTerminatedRelationship
        "Failure",
        "No Retry",
        "Original",
        "Response",
        "Retry" ;
    dct:requires nifi:Orchestrator ;
    dcat:qualifiedRelation [
        a dcat:Relationship ;
        dcat:hadRole "configShape" ;
        dct:relation :NifiInvokeHTTPConfigShape
    ] .

:NifiInvokeHTTPConfigShape
    a sh:NodeShape ;

    sh:target [
        a sh:SPARQLTarget ;
        sh:prefixes :prefixes ;
        sh:select """
            SELECT ?this WHERE {
                ?step prov:specializationOf nifi:InvokeHTTP ;
                    p-plan:hasInputVar/tcs:embedded ?this .
            }
        """
    ] ;

    sh:property [
        sh:path nifi:httpMethod ;
        sh:name "HTTP method" ;
        nifi:propertyName "HTTP Method" ;
        sh:datatype xsd:string ;
        sh:in ("GET" "POST" "PUT" "DELETE" "PATCH") ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    sh:property [
        sh:path nifi:httpUrl ;
        sh:name "HTTP URL" ;
        nifi:propertyName "HTTP URL" ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nifi:Orchestrator
    a tcs:PipelineComponent, dcat:Resource ;
    rdfs:label "Apache NiFi 2 Orchestrator" ;
    spdx:versionInfo "2.10.0" ;
    tcs:config
        :NifiDefaultDockerComposeConfig,
        :NifiDefaultDockerImageConfig .


:NifiDefaultDockerComposeConfig
    a tcs:Config, tcs:DefaultConfig, tcs:DockerComposeConfig ;
    dct:format "text/yaml" ;
    tcs:literal """
                nifip:
                    container_name: nifip
                    image: dishacled/nifi:2.10.0-ldi-2.12.0
                    build: ./nifi
                    environment:
                        SINGLE_USER_CREDENTIALS_USERNAME: root
                        SINGLE_USER_CREDENTIALS_PASSWORD: rootrootrootroot
                        NIFI_SENSITIVE_PROPS_KEY: dishacled-nifi-dev-key
                    ports:
                        - "8443:8443"
                    volumes:
                        - ./nifi/flow.json:/opt/nifi/bootstrap/flow.json:ro
                    entrypoint:
                        - /bin/bash
                        - "-c"
                        - |
                            set -e
                            gzip -c /opt/nifi/bootstrap/flow.json > /opt/nifi/nifi-current/conf/flow.json.gz
                            exec /opt/nifi/scripts/start.sh
                """ .

:NifiDefaultDockerImageConfig
    a tcs:Config, tcs:DefaultConfig, tcs:DockerImageConfig ;
    dct:format "text/x-dockerfile" ;
    tcs:literal """
                FROM maven:3.9-eclipse-temurin-21 AS nifi-extensions

                ARG LDI_NIFI_VERSION=2.12.0

                RUN mvn -B dependency:get \\
                    -Dartifact=be.vlaanderen.informatievlaanderen.ldes.ldi.nifi:ldi-processors-bundle:${LDI_NIFI_VERSION} \\
                && mkdir -p /out/nifi-ext \\
                && find /root/.m2/repository/be/vlaanderen/informatievlaanderen/ldes/ldi/nifi \\
                    -type f -name '*.nar' \\
                    -exec cp {} /out/nifi-ext/ \\;

                FROM apache/nifi:2.10.0

                COPY --from=nifi-extensions --chown=nifi:nifi \\
                    /out/nifi-ext/ \\
                    /opt/nifi/nifi-current/nar_extensions/
                """ .
