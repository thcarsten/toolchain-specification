#################################################################
# Prefixes
#################################################################

@prefix : <http://example.org/example/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/>.
@prefix ldio: <http://example.org/example/ldio/> .
@prefix mu: <http://mu.semte.ch/vocabularies/core/>.
@prefix nfo: <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#>.
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix p-plan: <http://purl.org/net/p-plan#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfc: <https://w3id.org/rdf-connect#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix sw: <https://semantic.works/services/> .
@prefix tcs: <https://w3id.org/toolchain#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix nifi: <http://example.org/example/nifi/> .


:prefixes
    sh:declare 
    [
        sh:prefix "" ;
        sh:namespace "http://example.org/example/" ;
    ] ,
    [
        sh:prefix "dcat" ;
        sh:namespace "http://www.w3.org/ns/dcat#" ;
    ] ,
    [
        sh:prefix "dct" ;
        sh:namespace "http://purl.org/dc/terms/" ;
    ] ,
    [
        sh:prefix "ldio" ;
        sh:namespace "http://example.org/example/ldio/" ;
    ] ,
    [
        sh:prefix "mu" ;
        sh:namespace "http://mu.semte.ch/vocabularies/core/" ;
    ] ,
    [
        sh:prefix "nfo" ;
        sh:namespace "http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#" ;
    ] ,
    [
        sh:prefix "nifi" ;
        sh:namespace "http://example.org/example/nifi/" ;
    ] ,
    [
        sh:prefix "owl" ;
        sh:namespace "http://www.w3.org/2002/07/owl#" ;
    ] ,
    [
        sh:prefix "p-plan" ;
        sh:namespace "http://purl.org/net/p-plan#" ;
    ] ,
    [
        sh:prefix "prov" ;
        sh:namespace "http://www.w3.org/ns/prov#" ;
    ] ,
    [
        sh:prefix "rdf" ;
        sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ;
    ] ,
    [
        sh:prefix "rdfc" ;
        sh:namespace "https://w3id.org/rdf-connect#" ;
    ] ,
    [
        sh:prefix "rdfs" ;
        sh:namespace "http://www.w3.org/2000/01/rdf-schema#" ;
    ] ,
    [
        sh:prefix "sh" ;
        sh:namespace "http://www.w3.org/ns/shacl#" ;
    ] ,
    [
        sh:prefix "spdx" ;
        sh:namespace "http://spdx.org/rdf/terms#" ;
    ] ,
    [
        sh:prefix "sw" ;
        sh:namespace "https://semantic.works/services/" ;
    ] ,
    [
        sh:prefix "tcs" ;
        sh:namespace "https://w3id.org/toolchain#" ;
    ] ,
    [
        sh:prefix "xsd" ;
        sh:namespace "http://www.w3.org/2001/XMLSchema#" ;
    ] .


#################################################################
# Package managers
#################################################################

# This is a stub
:pip rdfs:label "pip" ;
rdfs:comment "Python package manager. Packages annotated with this end up in pyproject.toml." .

:npm rdfs:label "npm" ;
rdfs:comment "Node.js package manager. Packages annotated with this end up in package.json." .


#################################################################
# Catalog
#################################################################

:DishacledCatalog
  a dcat:Catalog;
  dct:title "Datasets and processors used in DiSHACLed demonstrator.";
  dcat:dataset :waterLevelsInCm, :waterLevelsInMm ;
  dcat:resource
    # LDIO  
    ldio:HttpInPoller,
    ldio:RmlAdapter, 
    ldio:RdfAdapter, 
    ldio:SparqlConstructTransformer,
    ldio:ConsoleOut,
    ldio:HttpOut, 
    ldio:HttpIn,
    ldio:LinkedDataInteractionsOrchestrator,
    ldio:LdioPipelineStarterService,
    # RDF Connect
    rdfc:HttpFetch,
    rdfc:HttpIn,
    rdfc:thresholdMonitoringProcessor,
    rdfc:SparqlIngest,
    rdfc:LogProcessorPy,
    rdfc:HttpOut,
    rdfc:NodeRunner,
    rdfc:PyRunner,
    rdfc:Orchestrator, 
    # Semantic works
    sw:loket-error-alert-service,
    sw:deliver-email-service,
    sw:triple-store,
    # Nifi 2
    nifi:GenerateFlowFile,
    nifi:Funnel,
    nifi:InvokeHTTP,
    nifi:Orchestrator .


#################################################################
# Datasets
#################################################################

# Source dataset published by the mock JSON-LD APIs, but could also be others like LDES or SPARQL
:waterLevelsInCm a dcat:Dataset ;
  dct:conformsTo :waterLevelsInCmShape .

:waterLevelsInMm a dcat:Dataset ;
  dct:conformsTo :waterLevelsInMmShape .

# The mock JSON-LD APIs
:rawDataStreamInCm a dcat:DataService ;
  dcat:servesdataset :waterLevelsInCm ;
  # Optional, because dataset already provides this shape
  dcat:qualifiedRelation [
        a dcat:Relationship;
        dcat:hadRole :outputShape ;
        dct:relation :waterLevelsInCmShape
    ] .

:rawDataStreamInMm a dcat:Service ;
  dcat:servesdataset :waterLevelsInMm ;
  # Optional, because dataset already provides this shape
  dcat:qualifiedRelation [
        a dcat:Relationship;
        dcat:hadRole :outputShape ;
        dct:relation :waterLevelsInMmShape
    ] .


#################################################################
# LDIO Components
#################################################################

ldio:HttpInPoller a tcs:PipelineComponent, dcat:Resource;
    rdfs:label "Ldio:HttpInPoller" ; 
    ldio:type "Input" ;
    dcat:landingPage "https://informatievlaanderen.github.io/VSDS-Linked-Data-Interactions/2.8.0-SNAPSHOT/ldio/ldio-inputs/ldio-http-in-poller" ;
    dct:requires ldio:LinkedDataInteractionsOrchestrator .


ldio:RdfAdapter a tcs:PipelineComponent, dcat:Resource;
    rdfs:label "Ldio:RdfAdapter" ; 
    ldio:type "Adapter" ;
    dcat:landingPage "https://informatievlaanderen.github.io/VSDS-Linked-Data-Interactions/2.8.0-SNAPSHOT/ldio/ldio-adapters/ldio-rdf-adapter" ;
    dct:requires ldio:LinkedDataInteractionsOrchestrator .


ldio:SparqlConstructTransformer 
    a tcs:PipelineComponent, dcat:Resource ;
    rdfs:label "Ldio:SparqlConstructTransformer" ; 
    ldio:type "Transformer" ;
    dct:requires ldio:LinkedDataInteractionsOrchestrator .


ldio:HttpOut a tcs:PipelineComponent, dcat:Resource;
    rdfs:label "Ldio:HttpOut" ; 
    rdfs:description "The LDIO HTTP Out is a basic Http Client that will send the given Linked Data model to a target url.";
    ldio:type "Output" ;
    dcat:landingPage "https://informatievlaanderen.github.io/VSDS-Linked-Data-Interactions/2.8.0-SNAPSHOT/ldio/ldio-outputs/ldio-http-out" ;
    dct:requires ldio:LinkedDataInteractionsOrchestrator . 


ldio:LinkedDataInteractionsOrchestrator
    a tcs:PipelineComponent, dcat:Resource ;
    rdfs:label "Linked Data Interactions Orchestrator" ;
    dcat:landingPage "https://informatievlaanderen.github.io/VSDS-Linked-Data-Interactions/2.8.0-SNAPSHOT/" ;
    spdx:versionInfo "2.8.0-SNAPSHOT";
    tcs:config :LdioDefaultDockerComposeConfig ;
    dct:requires ldio:LdioPipelineStarterService .


:LdioDefaultDockerComposeConfig
    a tcs:Config, tcs:DefaultConfig, tcs:DockerComposeConfig ;
    dct:format "text/yaml" ;
    tcs:literal """
ldio-workbench:
    container_name: ldio-workbench
    image: ldes/ldi-orchestrator:2.8.0-SNAPSHOT
    ports:
      - "8080:8080"
""" .


ldio:LdioPipelineStarterService 
    a tcs:PipelineComponent, dcat:Resource ;
    rdfs:label "Ldio Pipeline Starter Service" ;
    tcs:config :LdioPipelineStarterDockerComposeConfig. 


:LdioPipelineStarterDockerComposeConfig
        a tcs:Config, tcs:DockerComposeConfig ;
        dct:format "text/yaml" ;
        tcs:literal '''
ldio-pipeline-starter:
    image: curlimages/curl
    volumes:
      - ./ldio_pipeline.yml:/pipeline.yml:ro
    command: >
      sh -c "
      sleep 30 &&
      curl -X POST
      -H 'content-type: application/yaml'
      http://ldio-workbench:8080/admin/api/v1/pipeline
      --data-binary @/pipeline.yml
      "         
''' .


#################################################################
# RDF Connect Components
#################################################################

rdfc:SparqlIngest a tcs:PipelineComponent, dcat:Resource;
    rdfs:label "Sparql Ingest";
    rdfs:description "This processor takes a stream of RDF records, transforms them into corresponding SPARQL Update queries, and executes them against a SPARQL Graph Store via the SPARQL Protocol." ; 
    dcat:landingPage "https://github.com/rdf-connect/sparql-ingest-processor-ts";
    dct:requires rdfc:NodeRunner;
    dct:requires [
        a spdx:Package ;
        spdx:name "@rdfc/sparql-ingest-processor-ts" ;
        spdx:versionInfo "^2.1.7" ;
        spdx:suppliedBy :npm
    ];
    owl:imports <./node_modules/@rdfc/sparql-ingest-processor-ts/processors.ttl> ;
    dcat:qualifiedRelation [
      dct:relation :SparqlIngestShape, :SparqlIngestConfigShape;
      dcat:hadRole "configShape" ;
    ] .


# This is an example of a nested Config in RDF-Connect: This shape references ingestConfig, which is an embedded config.
:SparqlIngestShape a sh:NodeShape;
      sh:target [
        a sh:SPARQLTarget ;
        sh:prefixes :prefixes ;
        sh:select """
            SELECT ?this WHERE {
                ?step prov:specializationOf rdfc:SparqlIngest ;
                      p-plan:hasInputVar/tcs:embedded ?this .
            }
        """
    ] ;
  sh:property [
    sh:path rdfc:memberStream;
    sh:name "memberStream";
    sh:class tcs:Channel;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path rdfc:ingestConfig;
    sh:name "config";
    sh:node :SparqlIngestConfigShape;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path rdfc:sparqlWriter;
    sh:name "sparqlWriter";
    sh:class tcs:Channel;
    sh:maxCount 1;
  ].


:SparqlIngestConfigShape a sh:NodeShape;
  sh:targetObjectsOf rdfc:ingestConfig;
  sh:property [
    sh:path rdfc:operationMode;
    sh:datatype xsd:string;
    sh:name "operationMode";
    sh:maxCount 1;
  ], [
    sh:path rdfc:memberBatchSize;
    sh:datatype xsd:integer;
    sh:name "memberBatchSize";
    sh:maxCount 1;
  ], [
    sh:path rdfc:memberShape;
    sh:datatype xsd:string;
    sh:name "memberShape";
    sh:maxCount 1;
  ], [
    sh:path rdfc:changeSemantics;
    sh:class rdfc:ChangeSemantics;
    sh:name "changeSemantics";
    sh:maxCount 1;
    sh:minCount 0;
  ], [
    sh:path rdfc:targetNamedGraph;
    sh:datatype xsd:string;
    sh:name "targetNamedGraph";
    sh:maxCount 1;
    sh:minCount 0;
  ], [
    sh:path rdfc:transactionConfig;
    sh:class rdfc:TransactionConfig;
    sh:name "transactionConfig";
    sh:maxCount 1;
    sh:minCount 0;
  ], [
    sh:path rdfc:graphStoreUrl;
    sh:datatype xsd:string;
    sh:name "graphStoreUrl";
    sh:maxCount 1;
    sh:minCount 0;
  ], [
    sh:path rdfc:forVirtuoso;
    sh:datatype xsd:boolean;
    sh:name "forVirtuoso";
    sh:maxCount 1;
    sh:minCount 0;
  ], [
    sh:path rdfc:accessToken;
    sh:datatype xsd:string;
    sh:name "accessToken";
    sh:maxCount 1;
    sh:minCount 0;
  ], [
    sh:path rdfc:measurePerformance;
    sh:class rdfc:PerformanceConfig;
    sh:name "measurePerformance";
    sh:maxCount 1;
    sh:minCount 0;
  ].





rdfc:HttpIn a tcs:PipelineComponent, dcat:Resource;
    rdfs:label "RDF Connect Http In";
    dct:requires rdfc:PyRunner;
    owl:imports <../../../usr/local/lib/python3.13/site-packages/rdfc_http_in/processor.ttl> . # I still need to build this component


rdfc:HttpOut a tcs:PipelineComponent, dcat:Resource;
    rdfs:label "RDF Connect Http Out";
    dct:requires rdfc:PyRunner;
    dct:requires [
        a spdx:Package ;
        spdx:name "rdfc_http_out" ;
        spdx:downloadLocation "file:///workspace/pipeline/local_processors/rdfc_http_out" ;
        spdx:suppliedBy :pip
    ] ;
    owl:imports <../../../usr/local/lib/python3.13/site-packages/rdfc_http_out/processor.ttl> . 


rdfc:thresholdMonitoringProcessor a :PipelineComponent, dcat:Resource ; # I still need to build this component
  dct:requires rdfc:NodeRunner ;
  owl:imports <../../../usr/local/lib/python3.13/site-packages/rdfc_threshold_monitoring/processor.ttl> . 


rdfc:NodeRunner a tcs:PipelineComponent, rdfc:Runner, dcat:Resource;
    rdfs:label "RDF Connect Javascript Node Runner" ; 
    dct:requires rdfc:Orchestrator ;
    dct:requires [
        a spdx:Package ;
        spdx:name "@rdfc/js-runner" ;
        spdx:versionInfo "^3.0.2" ;
        spdx:suppliedBy :npm
    ];
    owl:imports <./node_modules/@rdfc/js-runner/index.ttl> . # This is specific to RDF Connect


rdfc:PyRunner a tcs:PipelineComponent, rdfc:Runner, dcat:Resource;
    rdfs:label "RDF Connect Python Runner" ; 
    dct:requires rdfc:Orchestrator ;
    dct:requires [
        a spdx:Package ;
        spdx:name "rdfc-runner" ;
        spdx:versionInfo ">=1.0.0" ;
        spdx:suppliedBy :pip
    ]; 
    owl:imports <../../../usr/local/lib/python3.13/site-packages/rdfc_runner/index.ttl> . 


rdfc:Orchestrator a tcs:PipelineComponent, dcat:Resource ;
    rdfs:label "RDF Connect Orchestrator" ;
    dct:requires [
        a spdx:Package ;
        spdx:name "rdfc-proto" ;
        spdx:versionInfo ">=1.0.0" ;
        spdx:suppliedBy :pip
    ]; 
    dct:requires [
        a spdx:Package ;
        spdx:name "@rdfc/orchestrator-js" ;
        spdx:versionInfo "^2.0.1" ;
        spdx:suppliedBy :npm
    ]; 
    tcs:config [
        a tcs:Config, tcs:DockerComposeConfig ;
        dct:format "text/yaml" ;
        tcs:literal """
  rdf-connect:
    container_name: rdf-connect
    image: rdf-connect:latest
    build: ../../resources/rdfc-docker
    volumes:
      - ./rdfc_pipeline.ttl:/workspace/pipeline/pipeline.ttl:ro
    environment:
      LOG_LEVEL: debug
    command: npx rdfc /workspace/pipeline/pipeline.ttl
"""
];
tcs:config [
        a tcs:Config, tcs:DockerImageConfig ;
        dct:format "text/x-dockerfile" ;
        tcs:literal """
# Base: Alpine with Python 3.13
FROM python:3.13-slim-trixie AS rdfc-base

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \\
    bash \\
    curl \\
    wget \\
    unzip \\
    git \\
    openjdk-21-jdk-headless \\
    nodejs \\
    npm \\
    make \\
    g++ \\
    libc-dev \\
    && rm -rf /var/lib/apt/lists/*

# Install Gradle 8.10.2
ARG GRADLE_VERSION=8.10.2
RUN wget https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip -P /tmp \\
    && unzip /tmp/gradle-${GRADLE_VERSION}-bin.zip -d /opt \\
    && ln -s /opt/gradle-${GRADLE_VERSION}/bin/gradle /usr/bin/gradle \\
    && rm -rf /tmp/*.zip

# Install Python tools Hatch and uv
RUN pip install --no-cache-dir hatch uv

# Set working directory
WORKDIR /workspace

# Copy package.json and package-lock.json for npm caching
COPY package.json ./pipeline/

# Install all processors listed in package.json
RUN cd pipeline && npm install

# Set default working dir
WORKDIR /workspace/pipeline

# Keep container interactive
CMD ["/bin/bash"]
"""
] .


#################################################################
# Semantic.works Components
#################################################################

sw:loket-error-alert-service a tcs:PipelineComponent, mu:Microservice, dcat:Resource ;
  rdfs:description "Service that is responsible for sending out alerts when errors are inserted in the store. Build using the MU Javascript template.";
  dcat:landingPage <https://github.com/lblod/loket-error-alert-service> ;
  dct:requires sw:triple-store ;
  tcs:config [
        a tcs:DefaultConfig, tcs:DockerComposeConfig ;
        dct:format "text/yaml" ;
        tcs:literal """
error-alert:
    image: lblod/loket-error-alert-service
    volumes:
        - ./config/error-alert/:/config/
"""
] .


sw:deliver-email-service a tcs:PipelineComponent, mu:Microservice, dcat:Resource ;
  rdfs:description "Microservice that delivers emails from a mail folder" ;
  dcat:landingPage <https://github.com/lblod/berichtencentrum-deliver-email-service> ;
  dct:requires sw:triple-store ;
  tcs:config [
        a tcs:DefaultConfig, tcs:DockerComposeConfig ;
        dct:format "text/yaml" ;
        tcs:literal """
  berichtencentrum-deliver-email-service:
    image: lblod/berichtencentrum-deliver-email-service
"""
] .


sw:triple-store a tcs:PipelineComponent, dcat:Resource;
  dcat:landingPage <https://virtuoso.dev/react-virtuoso/> ;
    tcs:config [
        a tcs:DefaultConfig, tcs:DockerComposeConfig ;
        dct:format "text/yaml" ;
        tcs:literal """
virtuoso:
  image: redpencil/virtuoso:1.4.0
  environment:
    SPARQL_UPDATE: 'true'
"""
] .

#################################################################
# Apache NiFi Components
#################################################################

nifi:GenerateFlowFile
    a tcs:PipelineComponent, dcat:Resource ;
    rdfs:label "Apache NiFi GenerateFlowFile" ;
    nifi:processorType "org.apache.nifi.processors.standard.GenerateFlowFile" ;
    nifi:bundleGroup "org.apache.nifi" ;
    nifi:bundleArtifact "nifi-standard-nar" ;
    nifi:bundleVersion "2.10.0" ;
    nifi:outgoingRelationship "success" ;
    dct:requires nifi:Orchestrator ;
    dcat:qualifiedRelation [
        a dcat:Relationship ;
        dcat:hadRole "configShape" ;
        dct:relation :NifiGenerateFlowFileConfigShape
    ] .

:NifiGenerateFlowFileConfigShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:prefixes :prefixes ;
        sh:select """
            SELECT ?this WHERE {
                ?step prov:specializationOf nifi:GenerateFlowFile ;
                    p-plan:hasInputVar/tcs:embedded ?this .
            }
        """
    ] ;
    sh:property [
        sh:path nifi:customText ;
        sh:name "Custom Text" ;
        nifi:propertyName "Custom Text" ;
        sh:datatype xsd:string ;
        sh:maxCount 1
    ] .

nifi:Funnel
    a tcs:PipelineComponent, dcat:Resource ;
    rdfs:label "Apache NiFi Funnel" ;
    nifi:componentType "FUNNEL" ;
    dct:requires nifi:Orchestrator .

nifi:InvokeHTTP
    a tcs:PipelineComponent, dcat:Resource ;
    rdfs:label "Apache NiFi InvokeHTTP" ;
    nifi:processorType "org.apache.nifi.processors.standard.InvokeHTTP" ;
    nifi:bundleGroup "org.apache.nifi" ;
    nifi:bundleArtifact "nifi-standard-nar" ;
    nifi:bundleVersion "2.10.0" ;
    nifi:autoTerminatedRelationship
        "Failure",
        "No Retry",
        "Original",
        "Response",
        "Retry" ;
    dct:requires nifi:Orchestrator ;
    dcat:qualifiedRelation [
        a dcat:Relationship ;
        dcat:hadRole "configShape" ;
        dct:relation :NifiInvokeHTTPConfigShape
    ] .

:NifiInvokeHTTPConfigShape
    a sh:NodeShape ;

    sh:target [
        a sh:SPARQLTarget ;
        sh:prefixes :prefixes ;
        sh:select """
            SELECT ?this WHERE {
                ?step prov:specializationOf nifi:InvokeHTTP ;
                    p-plan:hasInputVar/tcs:embedded ?this .
            }
        """
    ] ;

    sh:property [
        sh:path nifi:httpMethod ;
        sh:name "HTTP method" ;
        nifi:propertyName "HTTP Method" ;
        sh:datatype xsd:string ;
        sh:in ("GET" "POST" "PUT" "DELETE" "PATCH") ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    sh:property [
        sh:path nifi:httpUrl ;
        sh:name "HTTP URL" ;
        nifi:propertyName "HTTP URL" ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nifi:Orchestrator
    a tcs:PipelineComponent, dcat:Resource ;
    rdfs:label "Apache NiFi 2 Orchestrator" ;
    spdx:versionInfo "2.10.0" ;
    tcs:config :NifiDefaultDockerComposeConfig .


:NifiDefaultDockerComposeConfig
    a tcs:Config, tcs:DefaultConfig, tcs:DockerComposeConfig ;
    dct:format "text/yaml" ;
    tcs:literal """
nifip:
    container_name: nifip
    image: apache/nifi:2.10.0
    environment:
        SINGLE_USER_CREDENTIALS_USERNAME: root
        SINGLE_USER_CREDENTIALS_PASSWORD: rootrootrootroot
        NIFI_SENSITIVE_PROPS_KEY: dishacled-nifi-dev-key
    ports:
        - "8443:8443"
    volumes:
        - ./nifi/flow.json:/opt/nifi/bootstrap/flow.json:ro
    entrypoint:
        - /bin/bash
        - "-c"
        - |
            set -e
            gzip -c /opt/nifi/bootstrap/flow.json > /opt/nifi/nifi-current/conf/flow.json.gz
            exec /opt/nifi/scripts/start.sh
""" .
