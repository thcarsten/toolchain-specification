@prefix : <http://example.org/example/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/>.
@prefix ldio: <http://example.org/example/ldio/> .
@prefix mu: <http://mu.semte.ch/vocabularies/core/>.
@prefix nfo: <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#>.
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix p-plan: <http://purl.org/net/p-plan#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfc: <https://w3id.org/rdf-connect#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix sw: <https://semantic.works/services/> .
@prefix tcs: <https://w3id.org/toolchain#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix nifi: <http://example.org/example/nifi/> .



#################################################################
# Pipeline Definition
#################################################################


:DemonstratorPipeline a tcs:PipelineDefinition;
    rdfs:label "Demonstrator Pipeline.";
    rdfs:comment "Polls API, transforms to RDF, detects threshold, triggers email alert.".

:GenerateFlowFile
    a tcs:InstancePipelineComponent ;
    prov:specializationOf nifi:GenerateFlowFile ;
    p-plan:isStepOfPlan :DemonstratorPipeline ;
    nifi:scheduledState "RUNNING" ;
    nifi:schedulingPeriod "10 sec" ;
    tcs:writesTo :nifi_channel_1 ;
    p-plan:hasInputVar [
        a tcs:PipelineConfig ;
        tcs:embedded [
            nifi:customText "Generated by DiSHACLed"
        ]
    ] .

:InvokeEndpoint
    a tcs:InstancePipelineComponent ;
    prov:specializationOf nifi:InvokeHTTP ;
    p-plan:isStepOfPlan :DemonstratorPipeline ;
    nifi:scheduledState "RUNNING" ;
    nifi:schedulingPeriod "0 sec" ;
    tcs:readsFrom :nifi_channel_1 ;
    tcs:writesTo :nifi_channel_2 ;
    p-plan:hasInputVar [
      a tcs:PipelineConfig ;
      tcs:embedded [
        nifi:httpMethod "GET" ;
        nifi:httpUrl "https://catfact.ninja/fact"
      ]
    ] .


:nifi_channel_2
    nifi:selectedRelationship "Response" .

:FetchAzureBlobStorage_v12
    a tcs:InstancePipelineComponent ;
    prov:specializationOf nifi:FetchAzureBlobStorage_v12 ;
    p-plan:isStepOfPlan :DemonstratorPipeline ;
    nifi:scheduledState "RUNNING" ;
    nifi:schedulingPeriod "0 sec" ;
    tcs:readsFrom :nifi_channel_1 ;
    tcs:writesTo :nifi_channel_azure ;
    p-plan:hasInputVar [
        a tcs:PipelineConfig ;
        tcs:embedded [
            nifi:containerName "limits" ;
            nifi:blobName "Waterkwaliteit_Brugge_${now():format('yyyyMM')}02.json" ;
            nifi:storageCredentials :AzureStorageCredentials ;
            nifi:clientSideEncryptionKeyType "NONE"
        ]
    ] .

:SplitText
    a tcs:InstancePipelineComponent ;
    prov:specializationOf nifi:SplitText ;
    p-plan:isStepOfPlan :DemonstratorPipeline ;
    nifi:scheduledState "RUNNING" ;
    nifi:schedulingPeriod "0 sec" ;
    tcs:readsFrom :nifi_channel_azure ;
    tcs:writesTo :nifi_channel_split, :nifi_channel_split_failure ;
    p-plan:hasInputVar [
        a tcs:PipelineConfig ;
        tcs:embedded [
            nifi:lineSplitCount "1" ;
            nifi:headerLineCount "0" ;
            nifi:removeTrailingNewlines "true"
        ]
    ] .

:nifi_channel_split
    nifi:selectedRelationship "splits" .

:nifi_channel_split_failure
    nifi:selectedRelationship "failure" .

:NifiFunnel
    a tcs:InstancePipelineComponent ;
    prov:specializationOf nifi:Funnel ;
    p-plan:isStepOfPlan :DemonstratorPipeline ;
    tcs:readsFrom :nifi_channel_2 .

:ExecuteGroovyScript
    a tcs:InstancePipelineComponent ;
    prov:specializationOf nifi:ExecuteGroovyScript ;
    p-plan:isStepOfPlan :DemonstratorPipeline ;
    nifi:scheduledState "RUNNING" ;
    nifi:schedulingPeriod "0 sec" ;
    tcs:readsFrom :nifi_channel_split ;
    tcs:writesTo :nifi_channel_groovy_success, :nifi_channel_groovy_failure ;
    p-plan:hasInputVar [
        a tcs:PipelineConfig ;
        tcs:embedded [
            nifi:failureStrategy "rollback" ;
            nifi:scriptBody """
                            import groovy.json.JsonSlurper
                            import groovy.json.JsonOutput
                            import org.apache.nifi.processor.io.StreamCallback
                            import java.time.LocalDateTime
                            import java.time.ZoneOffset
                            import java.time.format.DateTimeFormatter
                            import java.time.format.DateTimeFormatterBuilder
                            import java.time.temporal.ChronoField

                            // ── Helpers ───────────────────────────────────────────────────────────────────

                            def dms2dec = { String dms ->
                                def m = (dms =~ /(\\d+)[°](\\d+)[']([0-9.]+)["]?\\s*([NSEWnsew])/)
                                if (!m.find()) throw new IllegalArgumentException("Cannot parse DMS: ${dms}")
                                double dec = (m.group(1) as double) + (m.group(2) as double) / 60.0 + (m.group(3) as double) / 3600.0
                                return m.group(4).toUpperCase() in ['S', 'W'] ? -dec : dec
                            }

                            def parseTimeResult = { String s ->
                                def fmt = new DateTimeFormatterBuilder()
                                    .appendPattern("yyyy-MM-dd HH:mm:ss")
                                    .optionalStart().appendFraction(ChronoField.MICRO_OF_SECOND, 0, 6, true).optionalEnd()
                                    .toFormatter()
                                LocalDateTime.parse(s.trim(), fmt)
                            }

                            def DT_FORMAT = DateTimeFormatter.ofPattern("yyyy-MM-dd'T'HH:mm:ss")
                            def ISO_UTC   = DateTimeFormatter.ofPattern("yyyy-MM-dd'T'HH:mm:ss'Z'")
                            def DATE_ONLY = DateTimeFormatter.ofPattern("yyyyMMdd")

                            def CONTEXT = [
                                [
                                    "time"        : "http://www.w3.org/2006/time#",
                                    "dcterms"     : "http://purl.org/dc/terms/",
                                    "xml-schema"  : "http://www.w3.org/2001/XMLSchema#",
                                    "qudt-schema" : "https://qudt.org/schema/qudt/",
                                    "cl-idt"      : "https://example.com/concept/identificatortype/",
                                    "cl-ovt"      : "https://example.com/concept/observatieverzamelingtype/",
                                    "cl-opt"      : "https://example.com/concept/observatieproceduretype",
                                    "cl-fch"      : "https://data.omgeving.vlaanderen.be/id/concept/fysico-chemisch/",
                                    "cl-chs"      : "https://data.omgeving.vlaanderen.be/id/concept/chemische_stof/",
                                    "qudt-unit"   : "https://qudt.org/vocab/unit/",
                                    "schema"      : "http://schema.org/",
                                    "@base"       : "https://brugge.be/id/",
                                    "dcterms:isVersionOf": ["@type": "@id"]
                                ],
                                "https://data.vlaanderen.be/doc/applicatieprofiel/waterkwaliteit/kandidaatstandaard/2022-10-17/context/waterkwaliteit-ap.jsonld"
                            ]

                            // ── Core mapping (identical logic to local version) ───────────────────────────

                            def buildPayload = { src ->
                                def code = src.sample_code as String

                                if (!src.test_resultf || !src.measure_unit || !src.test_name || !src.time_result) {
                                    throw new IllegalStateException("Required field is null for sample ${code}")
                                }

                                def testNames   = (src.test_name    as String).split("_-_")
                                def testResults = (src.test_resultf as String).split("_-_")
                                def testUnits   = (src.measure_unit as String).split("_-_")
                                def testTimes   = (src.time_result  as String).split("_-_")

                                if (testNames.size() != testResults.size() || testNames.size() != testUnits.size() || testNames.size() != testTimes.size()) {
                                    throw new IllegalStateException(
                                        "Array length mismatch for sample ${code}: " +
                                        "names=${testNames.size()}, results=${testResults.size()}, " +
                                        "units=${testUnits.size()}, times=${testTimes.size()}"
                                    )
                                }

                                def graph = []

                                // ── WaterkwaliteitObservatieVerzameling ───────────────────────────────────
                                // @id is unversioned — CreateVersionObjectProcessor adds timestamp,
                                // dcterms:created and dcterms:isVersionOf in the NiFi flow
                                def ov = [:]
                                ov["@id"]   = "waterkwaliteitobservatieverzameling/${code}"
                                ov["@type"] = "WaterkwaliteitObservatieVerzameling"

                                if (src.gps_breedtegraad) {
                                    ov["schema:geo"] = [
                                        "schema:latitude" : dms2dec(src.gps_breedtegraad as String),
                                        "schema:longitude": dms2dec(src.gps_lengtegraad  as String)
                                    ]
                                }

                                ov["Locatie"] = src.staalnameplaats
                                ov["WaterkwaliteitObservatieVerzameling.geobserveerdObject"] = "bemonsteringsobject/${code}/1"

                                if (src.datum_staalname) {
                                    def dtStr = LocalDateTime.parse(src.datum_staalname as String, DT_FORMAT)
                                                            .atOffset(ZoneOffset.UTC).format(ISO_UTC)
                                    ov["WaterkwaliteitObservatieVerzameling.fenomeentijd"] = [
                                        "@type"             : "time:Instant",
                                        "time:inXSDDateTime": ["@type": "xml-schema:dateTime", "@value": dtStr]
                                    ]
                                }

                                ov["WaterkwaliteitObservatieVerzameling.lid"] = (0..<testNames.size()).collect {
                                    "observatie/${code}/${it + 1}"
                                }

                                graph << ov

                                testNames.eachWithIndex { name, k ->
                                    def obs = [:]
                                    obs["@id"]   = "observatie/${code}/${k + 1}"
                                    obs["@type"] = "Observatie"
                                    obs["Observatie.geobserveerdKenmerk"] = name.trim().replace(" ", "_")
                                    obs["Observatie.geobserveerdObject"]  = "bemonsteringsobject/${code}/1"

                                    def result = testResults[k].trim() as double
                                    if (result != 99999.99999) {
                                        obs["Observatie.resultaat"] = [
                                            "@type"    : "Maat",
                                            "Maat.maat": [
                                                "@type"                              : "KwantitatieveWaarde",
                                                "KwantitatieveWaarde.waarde"         : result,
                                                "KwantitatieveWaarde.standaardEenheid": [
                                                    "@type": "Unit",
                                                    "@id"  : testUnits[k].trim().replace(" ", "_")
                                                ]
                                            ]
                                        ]
                                    }

                                    if (src.datum_staalname) {
                                        def dtStr = LocalDateTime.parse(src.datum_staalname as String, DT_FORMAT)
                                                                .atOffset(ZoneOffset.UTC).format(ISO_UTC)
                                        obs["Observatie.fenomeentijd"] = [
                                            "@type"             : "time:Instant",
                                            // lowercase 'datetime' intentional — matches original Python output
                                            "time:inXSDDateTime": ["@type": "xml-schema:datetime", "@value": dtStr]
                                        ]
                                    }

                                    def timeResult = testTimes[k].trim()
                                    if (timeResult != "null") {
                                        obs["Observatie.resultaattijd"] = [
                                            "@type"             : "time:Instant",
                                            "time:inXSDDateTime": ["@type": "xml-schema:date", "@value": parseTimeResult(timeResult).format(DATE_ONLY)]
                                        ]
                                    }

                                    obs["Observatie.gebruikteProcedure"] = [
                                        "@type"                   : "Observatieprocedure",
                                        "Observatieprocedure.type": "cl-opt:laboanalyse"
                                    ]

                                    graph << obs
                                }

                                return ["@context": CONTEXT, "@graph": graph]
                            }

                            // ── NiFi I/O ──────────────────────────────────────────────────────────────────

                            def flowFile = session.get()
                            if (!flowFile) return

                            try {
                                flowFile = session.write(flowFile, { inputStream, outputStream ->
                                    def src = new JsonSlurper().parse(inputStream)
                                    def payload = buildPayload(src)
                                    outputStream.write(JsonOutput.toJson(payload).getBytes("UTF-8"))
                                } as StreamCallback)

                                session.transfer(flowFile, REL_SUCCESS)

                            } catch (Exception e) {
                                log.error("Mapping failed: ${e.message}", e)
                                session.transfer(flowFile, REL_FAILURE)
                            }

                            """
        ]
    ] .

:nifi_channel_groovy_success
    nifi:selectedRelationship "success" .

:nifi_channel_groovy_failure
    nifi:selectedRelationship "failure" .

:CreateVersionObjectProcessor
    a tcs:InstancePipelineComponent ;
    prov:specializationOf nifi:CreateVersionObjectProcessor ;
    p-plan:isStepOfPlan :DemonstratorPipeline ;
    nifi:scheduledState "RUNNING" ;
    nifi:schedulingPeriod "0 sec" ;
    tcs:readsFrom :nifi_channel_groovy_success ;
    tcs:writesTo :nifi_channel_version_data, :nifi_channel_version_failure ;
    p-plan:hasInputVar [
        a tcs:PipelineConfig ;
        tcs:embedded [
            nifi:dateObservedValueRdfProperty "https://uri.etsi.org/ngsi-ld/observedAt" ;
            nifi:generatedAtTimeProperty "dcterms:created" ;
            nifi:dataDestinationFormat "application/ld+json" ;
            nifi:memberRdfSyntaxType "https://data.vlaanderen.be/ns/waterkwaliteit#WaterkwaliteitObservatieVerzameling" ;
            nifi:delimiter "/" ;
            nifi:versionOfKey "dcterms:isVersionOf" ;
            nifi:dataInputFormat "application/ld+json"
        ]
    ] .

:nifi_channel_version_data
    nifi:selectedRelationship "data" .

:nifi_channel_version_failure
    nifi:selectedRelationship "valueNotFound", "unparseable" .

:ldessink
    a tcs:InstancePipelineComponent ;
    prov:specializationOf nifi:InvokeHTTP ;
    p-plan:isStepOfPlan :DemonstratorPipeline ;
    nifi:scheduledState "RUNNING" ;
    nifi:schedulingPeriod "0 sec" ;
    tcs:readsFrom :nifi_channel_version_data ;
    tcs:writesTo :ldes_response ;
    p-plan:hasInputVar [
      a tcs:PipelineConfig ;
      tcs:embedded [
        nifi:httpMethod "POST" ;
        nifi:httpUrl "http://host.docker.internal:9003/observations"
      ]
    ] .

:httpfunnel
    a tcs:InstancePipelineComponent ;
    prov:specializationOf nifi:Funnel ;
    p-plan:isStepOfPlan :DemonstratorPipeline ;
    tcs:readsFrom
        :ldes_response .

:ldes_response
    nifi:selectedRelationship "Failure" ;
    nifi:selectedRelationship "No Retry" ;
    nifi:selectedRelationship "Response" ;
    nifi:selectedRelationship "Retry" .

:AzureStorageCredentials
    a nifi:ControllerService ;
    nifi:instantiatesControllerService nifi:AzureStorageCredentialsControllerService_v12 ;
    tcs:config :AzureStorageCredentialsConfig .

:AzureStorageCredentialsConfig
    a tcs:PipelineConfig ;
    tcs:embedded :AzureStorageCredentialsProperties .

:AzureStorageCredentialsProperties
    nifi:credentialsType "SAS_TOKEN" ;
    nifi:endpointSuffix "blob.core.windows.net" .

:nifi_channel_azure
    nifi:selectedRelationship "success" .

:FailureFunnel
    a tcs:InstancePipelineComponent ;
    prov:specializationOf nifi:Funnel ;
    p-plan:isStepOfPlan :DemonstratorPipeline ;
    tcs:readsFrom
        :nifi_channel_split_failure,
        :nifi_channel_groovy_failure,
        :nifi_channel_version_failure .
