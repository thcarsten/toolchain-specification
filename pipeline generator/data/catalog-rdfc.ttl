# Config shape for rdfc:Sdsify, generated from its upstream
# SHACL shape. Referenced from the component via
# dcat:qualifiedRelation with role tcs:configShape, and
# additionally carries a SPARQL target so pySHACL validates the
# embedded step config directly.
:SdsifyShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:prefixes tcs:prefixes ;
        sh:select """
            SELECT ?this WHERE {
                ?step prov:specializationOf rdfc:Sdsify ;
                      p-plan:hasInputVar/tcs:embedded ?this .
            }
        """
    ] ;
    sh:property [
        sh:path rdfc:input ;
        sh:name "input" ;
        sh:class tcs:Channel ;
        tcs:upstreamClass rdfc:Reader ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path rdfc:metadataConfig ;
        sh:name "metadataConfig" ;
        sh:node :MetadataConfigShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path rdfc:metadataOutput ;
        sh:name "metadataOutput" ;
        sh:class tcs:Channel ;
        tcs:upstreamClass rdfc:Writer ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path rdfc:output ;
        sh:name "output" ;
        sh:class tcs:Channel ;
        tcs:upstreamClass rdfc:Writer ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path rdfc:readAsStream ;
        sh:name "readAsStream" ;
        sh:datatype xsd:boolean ;
        sh:minCount 0 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path rdfc:shape ;
        sh:name "shape" ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path rdfc:typeFilter ;
        sh:name "types" ;
        sh:nodeKind sh:IRI ;
        tcs:upstreamDatatype xsd:iri ;
        sh:minCount 0
    ] .

# Nested config object of rdfc:Sdsify, reached via
# rdfc:metadataConfig. Targeted by sh:targetObjectsOf rather
