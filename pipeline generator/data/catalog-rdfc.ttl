#################################################################
# Catalog — RDF-Connect components
#
# Every `rdfc:*` / `tm:*` / `proc:*` `tcs:PipelineComponent`
# definition (types, labels, `owl:imports`, `dct:requires` including
# `spdx:Package` dependencies), their `dcat:qualifiedRelation`
# configShapes, and the RDF-Connect `tcs:Config` docker-compose +
# Dockerfile bodies (`:RdfcOrchestratorDockerCompose`,
# `:RdfcOrchestratorDockerImage`).
#
# `:DishacledCatalog`'s base declaration + full `dcat:resource` list,
# the `:pip`/`:npm` package-manager stubs, and the shared
# `tcs:prefixes` SPARQL-prefix registry all live in catalog-core.ttl
# instead — the common file every other catalog file is meant to be
# loaded alongside (catalog-ldio.ttl, catalog-sw.ttl and
# catalog-application-profile-shapes.ttl).
#################################################################


#################################################################
# Prefixes
#################################################################

@prefix : <http://example.org/example/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix p-plan: <http://purl.org/net/p-plan#> .
@prefix proc: <http://dishacled.example.org/processors#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfc: <https://w3id.org/rdf-connect#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix tcs: <https://w3id.org/toolchain#> .
@prefix tm: <https://w3id.org/rdf-connect/threshold-monitor#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


#################################################################
# RDF Connect Components
#################################################################

rdfc:SPARQLIngest a tcs:PipelineComponent, dcat:Resource;
    rdfs:label "Sparql Ingest";
    rdfs:description "This processor takes a stream of RDF records, transforms them into corresponding SPARQL Update queries, and executes them against a SPARQL Graph Store via the SPARQL Protocol." ; 
    dcat:landingPage "https://github.com/rdf-connect/sparql-ingest-processor-ts";
    dct:requires rdfc:NodeRunner;
    dct:requires [
        a spdx:Package ;
        spdx:name "@rdfc/sparql-ingest-processor-ts" ;
        spdx:versionInfo "^2.1.7" ;
        spdx:suppliedBy :npm
    ];
    owl:imports <./node_modules/@rdfc/sparql-ingest-processor-ts/processors.ttl> ;
    dcat:qualifiedRelation [
        a dcat:Relationship ;
        dcat:hadRole tcs:configShape ;
        dct:relation [
            a sh:NodeShape ;
            sh:message "Checks that rdfc:SPARQLIngest's wiring (memberStream/ingestConfig/sparqlWriter) is well-typed." ;
            sh:property [
                sh:path rdfc:memberStream;
                sh:name "memberStream";
                sh:class rdfc:Reader;
                sh:maxCount 1;
            ], [
                sh:path rdfc:ingestConfig;
                sh:name "config";
                sh:node :IngestConfigShape;
                sh:minCount 1;
                sh:maxCount 1;
            ], [
                sh:path rdfc:sparqlWriter;
                sh:name "sparqlWriter";
                sh:class rdfc:Writer;
                sh:maxCount 1;
            ]
        ]
    ] .


rdfc:HttpOut a tcs:PipelineComponent, dcat:Resource;
    rdfs:label "RDF Connect Http Out";
    dct:requires rdfc:PyRunner;
    dct:requires [
        a spdx:Package ;
        spdx:name "rdfc_http_out" ;
        spdx:downloadLocation "file:///workspace/pipeline/local_processors/rdfc_http_out" ;
        spdx:suppliedBy :pip
    ] ;
    owl:imports <../../../usr/local/lib/python3.13/site-packages/rdfc_http_out/processor.ttl> . 


rdfc:NodeRunner a tcs:PipelineComponent, rdfc:Runner, dcat:Resource;
    rdfs:label "RDF Connect Javascript Node Runner" ; 
    dct:requires rdfc:Orchestrator ;
    dct:requires [
        a spdx:Package ;
        spdx:name "@rdfc/js-runner" ;
        spdx:versionInfo "^3.2.0" ;
        spdx:suppliedBy :npm
    ];
    owl:imports <./node_modules/@rdfc/js-runner/index.ttl> . # This is specific to RDF Connect


rdfc:PyRunner a tcs:PipelineComponent, rdfc:Runner, dcat:Resource;
    rdfs:label "RDF Connect Python Runner" ; 
    dct:requires rdfc:Orchestrator ;
    dct:requires [
        a spdx:Package ;
        spdx:name "rdfc-runner" ;
        spdx:versionInfo ">=1.0.0" ;
        spdx:suppliedBy :pip
    ]; 
    owl:imports <../../../usr/local/lib/python3.13/site-packages/rdfc_runner/index.ttl> . 


rdfc:Orchestrator a tcs:PipelineComponent, dcat:Resource ;
    rdfs:label "RDF Connect Orchestrator" ;
    dct:requires [
        a spdx:Package ;
        spdx:name "rdfc-proto" ;
        spdx:versionInfo ">=1.0.0" ;
        spdx:suppliedBy :pip
    ]; 
    dct:requires [
        a spdx:Package ;
        spdx:name "@rdfc/orchestrator-js" ;
        spdx:versionInfo "^2.2.1" ;
        spdx:suppliedBy :npm
    ]; 
    tcs:config :RdfcOrchestratorDockerCompose ,
               :RdfcOrchestratorDockerImage .


# HTTP fetch. Fetches a URL and writes the response to the output channel;
# previously a dangling `dcat:resource` entry in catalog-core.ttl with no
# definition anywhere (tracked in AGENTS.md §8) — now resolved.
rdfc:HttpFetch a tcs:PipelineComponent, dcat:Resource ;
    rdfs:label "HTTP Fetch processor" ;
    rdfs:description "This processor fetches a URL and writes the response to the output channel. It supports various options such as HTTP method, headers, authentication, and scheduling with cron expressions." ;
    dcat:landingPage "https://github.com/rdf-connect/http-utils-processor-ts" ;
    dct:requires rdfc:NodeRunner ;
    dct:requires [
        a spdx:Package ;
        spdx:name "@rdfc/http-utils-processor-ts" ;
        spdx:versionInfo "^1.2.0-alpha.1" ;
        spdx:suppliedBy :npm
    ] ;
    owl:imports <./node_modules/@rdfc/http-utils-processor-ts/processors.ttl> ;
    # Wiring metadata ported from the RDF-Connect package's own SHACL shape
    # (harvested rdfc_HttpFetch.ttl).
    dcat:qualifiedRelation [
        a dcat:Relationship ;
        dcat:hadRole tcs:configShape ;
        dct:relation [
            a sh:NodeShape ;
            sh:message "Checks that rdfc:HttpFetch's wiring (writer/url/options) is well-typed." ;
            sh:property [
                sh:path rdfc:writer ;
                sh:name "writer" ;
                sh:class rdfc:Writer ;
                sh:maxCount 1 ;
            ], [
                sh:path rdfc:url ;
                sh:name "url" ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
            ], [
                sh:path rdfc:options ;
                sh:name "options" ;
                sh:node :HttpFetchOptionsShape ;
                sh:maxCount 1 ;
            ]
        ]
    ] .

:HttpFetchOptionsShape a sh:NodeShape;
  sh:targetObjectsOf rdfc:options;
  sh:message "Checks that rdfc:HttpFetch's rdfc:options body is well-typed.";
  sh:property [
    sh:path rdfc:HttpFetchAuth;
    sh:name "auth";
    sh:node :HttpFetchAuthShape;
    sh:maxCount 1;
  ], [
    sh:path rdfc:acceptStatusCodes;
    sh:name "acceptStatusCodes";
    sh:datatype xsd:string;
  ], [
    sh:path rdfc:closeOnEnd;
    sh:name "closeOnEnd";
    sh:datatype xsd:boolean;
    sh:maxCount 1;
  ], [
    sh:path rdfc:cron;
    sh:name "cron";
    sh:datatype xsd:string;
    sh:maxCount 1;
  ], [
    sh:path rdfc:errorsAreFatal;
    sh:name "errorsAreFatal";
    sh:datatype xsd:boolean;
    sh:maxCount 1;
  ], [
    sh:path rdfc:headers;
    sh:name "headers";
    sh:datatype xsd:string;
  ], [
    sh:path rdfc:method;
    sh:name "method";
    sh:datatype xsd:string;
    sh:maxCount 1;
  ], [
    sh:path rdfc:outputAsBuffer;
    sh:name "outputAsBuffer";
    sh:datatype xsd:boolean;
    sh:maxCount 1;
  ], [
    sh:path rdfc:outputAsStream;
    sh:name "outputAsStream";
    sh:datatype xsd:boolean;
    sh:maxCount 1;
  ], [
    sh:path rdfc:runOnInit;
    sh:name "runOnInit";
    sh:datatype xsd:boolean;
    sh:maxCount 1;
  ], [
    sh:path rdfc:timeOutMilliseconds;
    sh:name "timeOutMilliseconds";
    sh:datatype xsd:integer;
    sh:maxCount 1;
  ].

:HttpFetchAuthShape a sh:NodeShape;
  sh:targetObjectsOf rdfc:HttpFetchAuth;
  sh:message "Checks that rdfc:HttpFetch's auth config body is well-typed.";
  sh:property [
    sh:path rdfc:type;
    sh:name "type";
    sh:datatype xsd:string;
    sh:minCount 1;
    sh:maxCount 1;
  ].


# HTTP ingest server. The demonstrator switched from the pull-based
# `rdfc:HttpFetch`/`rdfc:HttpIn` to an accept-a-POST server so the LDIO
# workbench can push enriched observations to `http://rdfc:9000/source-a`.
rdfc:HttpServer a tcs:PipelineComponent, dcat:Resource ;
    rdfs:label "HTTP Server processor";
    rdfs:description "This processor starts an HTTP server and writes the body of every incoming request to the output channel. It supports configuring the bind address, accepted HTTP method, path, and the status code returned to clients.";
    dcat:landingPage "https://github.com/rdf-connect/http-utils-processor-ts/blob/http-server/" ;
    dct:requires rdfc:NodeRunner ;
    dct:requires [
        a spdx:Package ;
        spdx:name "@rdfc/http-utils-processor-ts" ;
        spdx:versionInfo "^1.2.0-alpha.1" ;
        spdx:suppliedBy :npm
    ] ;
    owl:imports <./node_modules/@rdfc/http-utils-processor-ts/processors.ttl> ;
    # Wiring metadata ported from the RDF-Connect package's own SHACL shape
    # (see harvested definitions under DiSHACLed/toolchain-specification
    # PR #2, data/harvest/rdfc_HttpServer.ttl), kept on rdfc:Reader/Writer
    # rather than the PR's tcs:Channel + tcs:upstreamClass rewrite.
    dcat:qualifiedRelation [
        a dcat:Relationship ;
        dcat:hadRole tcs:configShape ;
        dct:relation [
            a sh:NodeShape ;
            sh:message "Checks that rdfc:HttpServer's wiring (port/writer/options) is well-typed." ;
            sh:property [
              sh:path rdfc:port;
              sh:name "port";
              sh:datatype xsd:integer;
              sh:minCount 1;
              sh:maxCount 1;
            ], [
              sh:path rdfc:writer;
              sh:name "writer";
              sh:class rdfc:Writer;
              sh:maxCount 1;
            ], [
              sh:path rdfc:options;
              sh:name "options";
              sh:node :HttpServerOptionsShape;
              sh:maxCount 1;
            ]
        ]
    ] ,
    # Writes the body of every incoming request verbatim onto its output
    # channel — serializes/deserializes bytes but preserves triples, a
    # pure passthrough at the RDF level. Trivial NodeShape; a pipeline
    # that knows what actually flows through may override this at the
    # instance level (see demo:HttpIngest in pipeline_definition.ttl).
    [
        a dcat:Relationship ;
        dcat:hadRole tcs:passthroughShape ;
        dct:relation [ a sh:NodeShape ; sh:message "HttpServer forwards every incoming request body unchanged — no constraint on its shape." ]
    ] .

:HttpServerOptionsShape a sh:NodeShape;
  sh:targetObjectsOf rdfc:options;
  sh:message "Checks that rdfc:HttpServer's rdfc:options body is well-typed.";
  sh:property [
    sh:path rdfc:host;
    sh:name "host";
    sh:datatype xsd:string;
    sh:maxCount 1;
  ], [
    sh:path rdfc:method;
    sh:name "method";
    sh:datatype xsd:string;
    sh:maxCount 1;
  ], [
    sh:path rdfc:path;
    sh:name "path";
    sh:datatype xsd:string;
    sh:maxCount 1;
  ], [
    sh:path rdfc:successStatusCode;
    sh:name "successStatusCode";
    sh:datatype xsd:integer;
    sh:maxCount 1;
  ], [
    sh:path rdfc:streamThresholdBytes;
    sh:name "streamThresholdBytes";
    sh:datatype xsd:integer;
    sh:maxCount 1;
  ].

  


# Streaming envelope. Wraps each entity of a given type
# (e.g. `sosa:Observation`) as an SDS record, and emits stream metadata
# on a paired `metadataOutput` channel.
rdfc:Sdsify a tcs:PipelineComponent, dcat:Resource ;
    rdfs:label "Sdsify processor";
    rdfs:description "Ingest a stream of RDF dumps and produce a stream of SDS records, based on the provided configuration.";
    dcat:landingPage "https://github.com/rdf-connect/sds-processors-ts" ;
    dct:requires rdfc:NodeRunner ;
    dct:requires [
        a spdx:Package ;
        spdx:name "@rdfc/sds-processors-ts" ;
        spdx:versionInfo "^3.0.1" ;
        spdx:suppliedBy :npm
    ] ;
    owl:imports <./node_modules/@rdfc/sds-processors-ts/configs/sdsify.ttl> ;
    # Wiring metadata ported from the RDF-Connect package's own SHACL shape
    # (harvested rdfc_Sdsify.ttl); two Writer paths are deliberate — the
    # main + metadata outputs are genuinely ambiguous, so wiring injection
    # must skip the writer side for this component and stay explicit.
    dcat:qualifiedRelation [
        a dcat:Relationship ;
        dcat:hadRole tcs:configShape ;
        dct:relation [
            a sh:NodeShape ;
            sh:message "Checks that rdfc:Sdsify's wiring (input/output/metadataOutput/metadataConfig/typeFilter/shape/readAsStream) is well-typed." ;
            sh:property [
              sh:class rdfc:Reader;
              sh:path rdfc:input;
              sh:name "input";
              sh:maxCount 1;
            ], [
              sh:class rdfc:Writer;
              sh:path rdfc:output;
              sh:name "output";
              sh:maxCount 1;
              sh:minCount 1;
            ], [
              sh:class rdfc:Writer;
              sh:path rdfc:metadataOutput;
              sh:name "metadataOutput";
              sh:maxCount 1;
              sh:minCount 1;
            ], [
              sh:node :MetadataConfigShape;
              sh:path rdfc:metadataConfig;
              sh:name "metadataConfig";
              sh:maxCount 1;
              sh:minCount 1;
            ], [
              sh:nodeKind sh:IRI;
              sh:path rdfc:typeFilter;
              sh:name "types";
              sh:minCount 0;
            ], [
              sh:datatype xsd:string;
              sh:path rdfc:shape;
              sh:name "shape";
              sh:minCount 0;
              sh:maxCount 1;
            ], [
              sh:datatype xsd:boolean;
              sh:path rdfc:readAsStream;
              sh:name "readAsStream";
              sh:minCount 0;
              sh:maxCount 1;
            ]
        ]
    ] ,
    # Each SDS member wraps a Concise Bounded Description (CBD) per
    # https://www.w3.org/submissions/CBD/ of whatever entity matched
    # rdfc:typeFilter. CBD is a graph-traversal definition (which
    # triples belong to the description), not a content schema — it
    # says nothing about which properties or classes appear, so no
    # non-trivial constraint can be asserted here in general. Open/
    # trivial shape at the component level; instance-specific content
    # (e.g. demo:SosaWaterLevelObservationShape) is asserted as the
    # inputShape instead, since the branching main/metadata output
    # can't be disambiguated without per-channel attachment (gap #2
    # in pipeline_definition.ttl's header).
    [
        a dcat:Relationship ;
        dcat:hadRole tcs:outputShape ;
        dct:relation [ a sh:NodeShape ; sh:message "Sdsify wraps whatever matched rdfc:typeFilter as a CBD-per-record SDS member — no non-trivial content schema can be asserted at the component level." ]
    ] .


:MetadataConfigShape a sh:NodeShape;
  sh:targetObjectsOf rdfc:metadataConfig;
  sh:message "Checks that rdfc:Sdsify's metadataConfig body is well-typed.";
  sh:property [
    sh:nodeKind sh:IRI;
    sh:path rdfc:streamId;
    sh:name "streamId";
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:datatype xsd:string;
    sh:path rdfc:description;
    sh:name "description";
    sh:maxCount 1;
  ], [
    sh:nodeKind sh:IRI;
    sh:path rdfc:timestampPath;
    sh:name "timestampPath";
    sh:maxCount 1;
  ], [
    sh:nodeKind sh:IRI;
    sh:path rdfc:versionOfPath;
    sh:name "versionOfPath";
    sh:maxCount 1;
  ], [
    sh:nodeKind sh:IRI;
    sh:path rdfc:shapeIri;
    sh:name "shapeIri";
    sh:maxCount 1;
  ],[
    sh:datatype xsd:string;
    sh:path rdfc:shape;
    sh:name "shape";
    sh:maxCount 1;
  ].



# Skolemization. Rewrites blank-node subjects to fresh named IRIs so
# downstream `rdfc:Sdsify` (which only extracts members with URIRef subjects)
# can process `oslc:Error` payloads emitted by the threshold monitor.
rdfc:SkolemizationProcessor a tcs:PipelineComponent, dcat:Resource ;
    rdfs:label "RDF Connect Skolemization Processor" ;
    dcat:landingPage "https://github.com/rdf-connect/skolemization-processor-ts" ;
    dct:requires rdfc:NodeRunner ;
    dct:requires [
        a spdx:Package ;
        spdx:name "@rdfc/skolemization-processor-ts" ;
        spdx:versionInfo "^1.0.0" ;
        spdx:suppliedBy :npm
    ] ;
    owl:imports <./node_modules/@rdfc/skolemization-processor-ts/processor.ttl> ;
    # Wiring metadata ported from the RDF-Connect package's own SHACL shape
    # (harvested rdfc_SkolemizationProcessor.ttl).
    dcat:qualifiedRelation [
        a dcat:Relationship ;
        dcat:hadRole tcs:configShape ;
        dct:relation [
            a sh:NodeShape ;
            sh:message "Checks that rdfc:SkolemizationProcessor's wiring (incoming/outgoing/mime) is well-typed." ;
            sh:property [
                sh:path rdfc:incoming ;
                sh:name "incoming" ;
                sh:class rdfc:Reader ;
                sh:maxCount 1 ;
            ], [
                sh:path rdfc:outgoing ;
                sh:name "outgoing" ;
                sh:class rdfc:Writer ;
                sh:maxCount 1 ;
            ], [
                sh:path rdfc:mime ;
                sh:name "MIME type" ;
                sh:datatype xsd:string ;
                sh:maxCount 1 ;
            ]
        ]
    ] ,
    # Rewrites blank-node subjects to fresh named IRIs but preserves the
    # star pattern per subject — the canonical passthrough example from
    # test suite/README.md. Trivial NodeShape at the component level.
    [
        a dcat:Relationship ;
        dcat:hadRole tcs:passthroughShape ;
        dct:relation [ a sh:NodeShape ; sh:message "SkolemizationProcessor rewrites blank-node subjects to named IRIs but preserves the star pattern per subject — no constraint on its shape." ]
    ] .


# Log processor. Terminal step that drains a channel to the container
# log — used in the demonstrator to consume Sdsify's mandatory-but-unused
# metadata sidechannels.
rdfc:LogProcessorJs a tcs:PipelineComponent, dcat:Resource ;
    rdfs:label "RDF Connect Log Processor (JS)" ;
    dcat:landingPage "https://github.com/rdf-connect/log-processor-ts" ;
    dct:requires rdfc:NodeRunner ;
    dct:requires [
        a spdx:Package ;
        spdx:name "@rdfc/log-processor-ts" ;
        spdx:versionInfo "^2.0.3" ;
        spdx:suppliedBy :npm
    ] ;
    owl:imports <./node_modules/@rdfc/log-processor-ts/processor.ttl> ;
    # Wiring metadata ported from the RDF-Connect package's own SHACL shape
    # (harvested rdfc_LogProcessorJs.ttl).
    dcat:qualifiedRelation [
        a dcat:Relationship ;
        dcat:hadRole tcs:configShape ;
        dct:relation [
            a sh:NodeShape ;
            sh:message "Checks that rdfc:LogProcessorJs's wiring (reader/writer/label/level/raw/readAsStream) is well-typed." ;
            sh:property [
                sh:path rdfc:reader ;
                sh:name "reader" ;
                sh:class rdfc:Reader ;
                sh:maxCount 1 ;
            ], [
                sh:path rdfc:writer ;
                sh:name "writer" ;
                sh:class rdfc:Writer ;
                sh:minCount 0 ;
                sh:maxCount 1 ;
            ], [
                sh:path rdfc:label ;
                sh:name "label" ;
                sh:datatype xsd:string ;
                sh:maxCount 1 ;
            ], [
                sh:path rdfc:level ;
                sh:name "level" ;
                sh:datatype xsd:string ;
                sh:maxCount 1 ;
            ], [
                sh:path rdfc:raw ;
                sh:name "raw" ;
                sh:datatype xsd:boolean ;
                sh:maxCount 1 ;
            ], [
                sh:path rdfc:readAsStream ;
                sh:name "readAsStream" ;
                sh:datatype xsd:boolean ;
                sh:maxCount 1 ;
            ]
        ]
    ] .


# Python counterpart of rdfc:LogProcessorJs. Previously a dangling
# `dcat:resource` entry in catalog-core.ttl with no definition anywhere
# (tracked in AGENTS.md §8) — now resolved.
rdfc:LogProcessorPy a tcs:PipelineComponent, dcat:Resource ;
    rdfs:label "Python Log Processor" ;
    rdfs:description "A simple Python processor to log an incoming stream to the RDF-Connect logging system." ;
    dcat:landingPage "https://rdf-connect.github.io" ;
    dct:requires rdfc:PyRunner ;
    dct:requires [
        a spdx:Package ;
        spdx:name "rdfc_log-processor" ;
        spdx:versionInfo ">=1.0.0" ;
        spdx:suppliedBy :pip
    ] ;
    owl:imports <../../../usr/local/lib/python3.13/site-packages/rdfc_log_processor/processor.ttl> ;
    # Wiring metadata ported from the RDF-Connect package's own SHACL shape
    # (harvested rdfc_LogProcessorPy.ttl).
    dcat:qualifiedRelation [
        a dcat:Relationship ;
        dcat:hadRole tcs:configShape ;
        dct:relation [
            a sh:NodeShape ;
            sh:message "Checks that rdfc:LogProcessorPy's wiring (reader/writer/label/level/raw) is well-typed." ;
            sh:property [
                sh:path rdfc:reader ;
                sh:name "reader" ;
                sh:class rdfc:Reader ;
                sh:maxCount 1 ;
            ], [
                sh:path rdfc:writer ;
                sh:name "writer" ;
                sh:class rdfc:Writer ;
                sh:maxCount 1 ;
            ], [
                sh:path rdfc:label ;
                sh:name "label" ;
                sh:datatype xsd:string ;
                sh:maxCount 1 ;
            ], [
                sh:path rdfc:level ;
                sh:name "level" ;
                sh:datatype xsd:string ;
                sh:maxCount 1 ;
            ], [
                sh:path rdfc:raw ;
                sh:name "raw" ;
                sh:datatype xsd:boolean ;
                sh:maxCount 1 ;
            ]
        ]
    ] .


# Threshold monitor (JS implementation). Replaces the stub
# `rdfc:thresholdMonitoringProcessor` above — the demonstrator targets
# `tm:ThresholdMonitorJs` from the `tm:` namespace, with additional
# per-run configuration on `tm:stream` / `tm:creator` / `tm:path`.
# Uses `tm:`, not `rdfc:`, because the upstream package itself publishes
# its component type and custom properties under that namespace.
tm:ThresholdMonitorJs a tcs:PipelineComponent, dcat:Resource ;
    rdfs:label "Threshold Monitor (JS)" ;
    rdfs:description "Compares a numeric value along an RDF path on each incoming SDS member against configurable min/max bounds; emits an oslc:Error on violation." ;
    dcat:landingPage "https://www.npmjs.com/package/@rdfc/threshold-monitor-processor-ts" ;
    dct:requires rdfc:NodeRunner ;
    dct:requires [
        a spdx:Package ;
        spdx:name "@rdfc/threshold-monitor-processor-ts" ;
        spdx:versionInfo "^0.0.1-alpha.2" ;
        spdx:suppliedBy :npm
    ] ;
    owl:imports <./node_modules/@rdfc/threshold-monitor-processor-ts/processor.ttl> ;
    # Wiring metadata ported from the RDF-Connect package's own SHACL shape
    # (harvested tm_ThresholdMonitorJs.ttl). `tm:path`'s upstream shape
    # nests an rdf-lens `PathLens` validator (`:ShaclPathShape`) that isn't
    # ported here — left as a plain property until that's needed.
    dcat:qualifiedRelation [
        a dcat:Relationship ;
        dcat:hadRole tcs:configShape ;
        dct:relation [
            a sh:NodeShape ;
            sh:message "Checks that tm:ThresholdMonitorJs's wiring (reader/writer/label/creator/max/min/path/stream) is well-typed." ;
            sh:property [
                sh:path rdfc:reader ;
                sh:name "reader" ;
                sh:class rdfc:Reader ;
                sh:maxCount 1 ;
            ], [
                sh:path rdfc:writer ;
                sh:name "writer" ;
                sh:class rdfc:Writer ;
                sh:maxCount 1 ;
            ], [
                sh:path rdfs:label ;
                sh:name "label" ;
                sh:datatype xsd:string ;
                sh:maxCount 1 ;
            ], [
                sh:path tm:creator ;
                sh:name "creator" ;
                sh:nodeKind sh:IRI ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ], [
                sh:path tm:max ;
                sh:name "max" ;
                sh:datatype xsd:double ;
                sh:maxCount 1 ;
            ], [
                sh:path tm:min ;
                sh:name "min" ;
                sh:datatype xsd:double ;
                sh:maxCount 1 ;
            ], [
                sh:path tm:path ;
                sh:name "path" ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ], [
                sh:path tm:stream ;
                sh:name "streamId" ;
                sh:nodeKind sh:IRI ;
                sh:maxCount 1 ;
            ]
        ]
    ] .


# Custom local processor. Converts incoming JSON-LD bytes to N-Quads
# for the SDS tooling downstream. Not published on npm — the source lives
# in the demonstrator repo at `demonstrator/RDFC/processors/jsonld-to-nquads/`
# and is copied into the RDFC container at build time.
# Uses `proc:`, not `rdfc:`, because it has no upstream package to inherit
# the core RDF-Connect namespace from.
proc:JsonLdToNQuads a tcs:PipelineComponent, dcat:Resource ;
    rdfs:label "JSON-LD to N-Quads processor";
    rdfs:description "Parses incoming JSON-LD strings and serializes them as N-Quads for downstream RDF processors.";
    dct:requires rdfc:NodeRunner ;
    dct:requires [
        a spdx:Package ;
        spdx:name "jsonld-to-nquads" ;
        spdx:downloadLocation "file:///workspace/pipeline/processors/jsonld-to-nquads" ;
        spdx:suppliedBy :npm
    ] ;
    dct:requires [
        a spdx:Package ;
        spdx:name "jsonld" ;
        spdx:versionInfo "^9.0.0" ;
        spdx:suppliedBy :npm
    ] ;
    owl:imports <./processors/jsonld-to-nquads/processor.ttl> ;
    # Placeholder wiring metadata — predicate names copied verbatim from
    # the pipeline definition's embedded config, pending verification
    # against the real processor.ttl.
    dcat:qualifiedRelation [
        dcat:hadRole tcs:configShape ;
        dct:relation [
            a sh:NodeShape ;
            sh:message "Checks that proc:JsonLdToNQuads's wiring (reader/writer) is well-typed." ;
            sh:property [
                sh:path rdfc:reader ;
                sh:name "reader" ;
                sh:class rdfc:Reader ;
                sh:maxCount 1 ;
            ], [
                sh:path rdfc:writer ;
                sh:name "writer" ;
                sh:class rdfc:Writer ;
                sh:maxCount 1 ;
            ]
        ]
    ] ,
    # Parses JSON-LD (already self-describing RDF via its own embedded
    # @context) into N-Quads — a pure serialization change, not a model
    # transform: the same graph flows through, just re-encoded. Trivial
    # NodeShape at the component level; overridden at the instance level
    # in pipeline_definition.ttl (demo:JsonLdToRdf).
    [
        a dcat:Relationship ;
        dcat:hadRole tcs:passthroughShape ;
        dct:relation [ a sh:NodeShape ; sh:message "JsonLdToNQuads changes serialization only — the same graph flows through, just re-encoded as N-Quads." ]
    ] .

:RdfcOrchestratorDockerCompose
    a tcs:Config, tcs:DockerComposeConfig ;
    dct:format "text/yaml" ;
    tcs:literal """
  rdfc:
    container_name: rdfc
    image: rdf-connect:latest
    build: ../../resources/rdfc-docker
    volumes:
      - ./rdfc_pipeline.ttl:/workspace/pipeline/pipeline.ttl:ro
    environment:
      LOG_LEVEL: debug
    command: npx rdfc /workspace/pipeline/pipeline.ttl
""" .


:RdfcOrchestratorDockerImage
    a tcs:Config, tcs:DockerImageConfig ;
    dct:format "text/x-dockerfile" ;
    tcs:literal """
# Base: Alpine with Python 3.13
FROM python:3.13-slim-trixie AS rdfc-base

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \\
    bash \\
    curl \\
    wget \\
    unzip \\
    git \\
    openjdk-21-jdk-headless \\
    nodejs \\
    npm \\
    make \\
    g++ \\
    libc-dev \\
    && rm -rf /var/lib/apt/lists/*

# Install Gradle 8.10.2
ARG GRADLE_VERSION=8.10.2
RUN wget https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip -P /tmp \\
    && unzip /tmp/gradle-${GRADLE_VERSION}-bin.zip -d /opt \\
    && ln -s /opt/gradle-${GRADLE_VERSION}/bin/gradle /usr/bin/gradle \\
    && rm -rf /tmp/*.zip

# Install Python tools Hatch and uv
RUN pip install --no-cache-dir hatch uv

# Set working directory
WORKDIR /workspace

# Copy package.json and package-lock.json for npm caching
COPY package.json ./pipeline/

# Install all processors listed in package.json
RUN cd pipeline && npm install

# Set default working dir
WORKDIR /workspace/pipeline

# Keep container interactive
CMD ["/bin/bash"]
""" .


#################################################################
# RDF-Connect — component-scoped SHACL shapes
#
# Discovered by pySHACL via the tcs application profile. Distinct
# from `catalog-application-profile-shapes.ttl` (the tcs application
# profile that applies to the whole vocabulary, independent of catalog
# contents). Uses the shared `tcs:prefixes` registry declared in
# catalog-core.ttl.
#################################################################


#################################################################
# rdfc:SPARQLIngest's nested config shapes.
# `rdfc:ingestConfig`'s body is untyped in the pipeline definition
# (embedded as a plain blank node), so these are targeted by
# `sh:targetObjectsOf` rather than `sh:targetClass` — the latter would
# never fire. Referenced via `sh:node` from the component's own inline
# `dcat:qualifiedRelation` configShape above.
#################################################################

:IngestConfigShape a sh:NodeShape;
  sh:targetObjectsOf rdfc:ingestConfig;
  sh:message "Checks that rdfc:SPARQLIngest's ingestConfig body is well-typed.";
  sh:property [
    sh:path rdfc:operationMode;
    sh:datatype xsd:string;
    sh:name "operationMode";
    sh:maxCount 1;
  ], [
    sh:path rdfc:memberBatchSize;
    sh:datatype xsd:integer;
    sh:name "memberBatchSize";
    sh:maxCount 1;
  ], [
    sh:path rdfc:memberShape;
    sh:datatype xsd:string;
    sh:name "memberShape";
    sh:maxCount 1;
  ], [
    sh:path rdfc:changeSemantics;
    sh:node :ChangeSemanticsShape;
    sh:name "changeSemantics";
    sh:maxCount 1;
    sh:minCount 0;
  ], [
    sh:path rdfc:targetNamedGraph;
    sh:datatype xsd:string;
    sh:name "targetNamedGraph";
    sh:maxCount 1;
    sh:minCount 0;
  ], [
    sh:path rdfc:transactionConfig;
    sh:node :TransactionConfigShape;
    sh:name "transactionConfig";
    sh:maxCount 1;
    sh:minCount 0;
  ], [
    sh:path rdfc:graphStoreUrl;
    sh:datatype xsd:string;
    sh:name "graphStoreUrl";
    sh:maxCount 1;
    sh:minCount 0;
  ], [
    sh:path rdfc:forVirtuoso;
    sh:datatype xsd:boolean;
    sh:name "forVirtuoso";
    sh:maxCount 1;
    sh:minCount 0;
  ], [
    sh:path rdfc:accessToken;
    sh:datatype xsd:string;
    sh:name "accessToken";
    sh:maxCount 1;
    sh:minCount 0;
  ], [
    sh:path rdfc:measurePerformance;
    sh:node :PerformanceConfigShape;
    sh:name "measurePerformance";
    sh:maxCount 1;
    sh:minCount 0;
  ].


:PerformanceConfigShape a sh:NodeShape;
  sh:targetObjectsOf rdfc:measurePerformance;
  sh:message "Checks that rdfc:measurePerformance's config body is well-typed.";
  sh:property [
    sh:path rdfc:name;
    sh:datatype xsd:string;
    sh:name "name";
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:path rdfc:outputPath;
    sh:datatype xsd:string;
    sh:name "outputPath";
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:path rdfc:failureIsFatal;
    sh:datatype xsd:boolean;
    sh:name "failureIsFatal";
    sh:maxCount 1;
    sh:minCount 0;
  ], [
    sh:path rdfc:queryTimeout;
    sh:datatype xsd:integer;
    sh:name "queryTimeout";
    sh:maxCount 1;
    sh:minCount 0;
  ].

:ChangeSemanticsShape a sh:NodeShape;
  sh:targetObjectsOf rdfc:changeSemantics;
  sh:message "Checks that rdfc:changeSemantics's config body is well-typed.";
  sh:property [
    sh:path rdfc:changeTypePath;
    sh:datatype xsd:string;
    sh:name "changeTypePath";
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:path rdfc:createValue;
    sh:datatype xsd:string;
    sh:name "createValue";
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:path rdfc:updateValue;
    sh:datatype xsd:string;
    sh:name "updateValue";
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:path rdfc:deleteValue;
    sh:datatype xsd:string;
    sh:name "deleteValue";
    sh:maxCount 1;
    sh:minCount 1;
  ].

:TransactionConfigShape a sh:NodeShape;
  sh:targetObjectsOf rdfc:transactionConfig;
  sh:message "Checks that rdfc:transactionConfig's config body is well-typed.";
  sh:property [
    sh:path rdfc:transactionIdPath;
    sh:datatype xsd:string;
    sh:name "transactionIdPath";
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:path rdfc:transactionEndPath;
    sh:datatype xsd:string;
    sh:name "transactionEndPath";
    sh:maxCount 1;
    sh:minCount 1;
  ].

