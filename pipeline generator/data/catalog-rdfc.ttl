# Config shape for rdfc:HttpFetch, generated from its upstream
# SHACL shape. Referenced from the component via
# dcat:qualifiedRelation with role tcs:configShape, and
# additionally carries a SPARQL target so pySHACL validates the
# embedded step config directly.
:HttpFetchShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:prefixes tcs:prefixes ;
        sh:select """
            SELECT ?this WHERE {
                ?step prov:specializationOf rdfc:HttpFetch ;
                      p-plan:hasInputVar/tcs:embedded ?this .
            }
        """
    ] ;
    sh:property [
        sh:path rdfc:options ;
        sh:name "options" ;
        sh:node :HttpFetchOptionsShape ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path rdfc:url ;
        sh:name "url" ;
        sh:datatype xsd:string ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path rdfc:writer ;
        sh:name "writer" ;
        sh:class tcs:Channel ;
        tcs:upstreamClass rdfc:Writer ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

# Nested config object of rdfc:HttpFetch, reached via
# rdfc:options. Targeted by sh:targetObjectsOf rather than
