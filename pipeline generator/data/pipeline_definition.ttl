@prefix : <http://example.org/example/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/>.
@prefix ldio: <http://example.org/example/ldio/> .
@prefix mu: <http://mu.semte.ch/vocabularies/core/>.
@prefix nfo: <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#>.
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix p-plan: <http://purl.org/net/p-plan#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfc: <https://w3id.org/rdf-connect#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix sw: <https://semantic.works/services/> .
@prefix tcs: <https://w3id.org/toolchain#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .



#################################################################
# Pipeline Definition
#################################################################


:DemonstratorPipeline a tcs:PipelineDefinition;
    rdfs:label "Demonstrator Pipeline.";
    rdfs:comment "Polls API, transforms to RDF, detects threshold, triggers email alert.".


:ApiPoll a tcs:InstancePipelineComponent ;
    prov:specializationOf ldio:HttpInPoller ;
    p-plan:isStepOfPlan :DemonstratorPipeline ;
    p-plan:hasInputVar [ a tcs:PipelineConfig ;
                tcs:embedded 
                    [
                        :url "https://dishacled-api.azurewebsites.net/api/v1/source-a/current" ;
                        :cron "*/10 * * * * *" # Every 10 seconds
            ] 
    ];
    tcs:writesTo :channel_1 .

    
:RdfConversion a tcs:InstancePipelineComponent ;
    prov:specializationOf ldio:RdfAdapter ;
    p-plan:isStepOfPlan :DemonstratorPipeline ;
   tcs:readsFrom :channel_1; 
   tcs:writesTo :channel_2 .


:SparqlConstruct a tcs:InstancePipelineComponent ;
    prov:specializationOf ldio:SparqlConstructTransformer ;
    p-plan:isStepOfPlan :DemonstratorPipeline ;
    p-plan:hasInputVar [
        a tcs:PipelineConfig;
        tcs:embedded
        [
          :query """
            PREFIX dct: <http://purl.org/dc/terms/> .
            PREFIX prov: <http://www.w3.org/ns/prov#> .
            CONSTRUCT {
              ?versionedS ?p ?o ;
                  prov:generatedAtTime ?generatedAtTime ;
                  dct:isVersionOf ?s .
            } WHERE {
              ?s ?p ?o .
              BIND(URI(CONCAT(STR(?s), '/', STR(?now))) as ?versionedS)
              BIND (NOW() as ?generatedAtTime)
            }
          """
        ]
    ]; 
    tcs:readsFrom :channel_2;
    tcs:writesTo :channel_3 .

:HttpOut a tcs:InstancePipelineComponent ;
    prov:specializationOf ldio:HttpOut ;
    p-plan:isStepOfPlan :DemonstratorPipeline ;
    tcs:readsFrom :channel_3;
    tcs:writesTo :channel_4 .


:HttpIn a tcs:InstancePipelineComponent ;
    prov:specializationOf rdfc:HttpIn ;
    p-plan:isStepOfPlan :DemonstratorPipeline ;
    p-plan:hasInputVar [
        a tcs:PipelineConfig;
        tcs:embedded
        [
          rdfc:writer :channel_5
        ]
    ] ;
    tcs:readsFrom :channel_4;
    tcs:writesTo :channel_5 .


:ThresholdMonitoring  a tcs:InstancePipelineComponent ;
    prov:specializationOf rdfc:thresholdMonitoringProcessor ;
    p-plan:isStepOfPlan :DemonstratorPipeline ;
      p-plan:hasInputVar [
    a tcs:PipelineConfig;
    tcs:embedded
    [
      rdfc:reader :channel_5 ;
      rdfc:writer :channel_6 ;
      rdfc:value 30 ;
      rdfc:unit <http://qudt.org/vocab/unit/CentiM>
    ]
    ] ;
    tcs:readsFrom :channel_5;
    tcs:writesTo :channel_6 .


:SparqlIngest a tcs:InstancePipelineComponent ;
  prov:specializationOf rdfc:SparqlIngest ;
  p-plan:isStepOfPlan :DemonstratorPipeline ;
  p-plan:hasInputVar [
    a tcs:Config;
    tcs:embedded
    [
      rdfc:memberStream :channel_6 ;
      rdfc:ingestConfig [
        rdfc:operationMode "Replication"
      ]
    ]
  ] .


:TriggerAlert a tcs:InstancePipelineComponent ;
  prov:specializationOf sw:loket-error-alert-service ;
    p-plan:isStepOfPlan :DemonstratorPipeline ;  
    p-plan:hasInputVar [
      a tcs:Config;
      tcs:embedded
      [
        :EMAIL_FROM "info@dishacled.com" ;
        :EMAIL_TO "everyone@world.com";
        :DEBUG false
      ]
  ] .

:DeliverEmail a tcs:InstancePipelineComponent ;
  prov:specializationOf sw:deliver-email-service ;
    p-plan:isStepOfPlan :DemonstratorPipeline ;
    p-plan:hasInputVar [
        a tcs:Config;
        tcs:embedded
        [
          :MAILFOLDER_URI "http://data.lblod.info/id/mail-folders/2" ;
          :EMAIL_CRON_PATTERN '*/1 * * * * *' ;
          :HOURS_DELIVERING_TIMEOUT '1' ;
        ]
] .
