#################################################################
# Component-scoped SHACL shapes
#
# Shapes attached to individual catalog components via
# `dcat:qualifiedRelation` + `dcat:hadRole` in catalog-core.ttl.
# Meant to be loaded together with catalog-core.ttl and
# catalog-configs.ttl; discovered by pySHACL via the tcs application
# profile.
#
# Distinct from `tcs_shapes.ttl` (the tcs application profile that
# applies to the whole vocabulary, independent of catalog contents).
#################################################################


#################################################################
# Prefixes
#################################################################

@prefix : <http://example.org/example/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix ldio: <http://example.org/example/ldio/> .
@prefix mu: <http://mu.semte.ch/vocabularies/core/> .
@prefix nfo: <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix p-plan: <http://purl.org/net/p-plan#> .
@prefix proc: <http://dishacled.example.org/processors#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfc: <https://w3id.org/rdf-connect#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix sw: <https://semantic.works/services/> .
@prefix tcs: <https://w3id.org/toolchain#> .
@prefix tm: <https://w3id.org/rdf-connect/threshold-monitor#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


#################################################################
# SHACL prefix declarations for SPARQL targets in shapes below
#################################################################

:prefixes
    sh:declare
    [
        sh:prefix "" ;
        sh:namespace "http://example.org/example/" ;
    ] ,
    [
        sh:prefix "dcat" ;
        sh:namespace "http://www.w3.org/ns/dcat#" ;
    ] ,
    [
        sh:prefix "dct" ;
        sh:namespace "http://purl.org/dc/terms/" ;
    ] ,
    [
        sh:prefix "ldio" ;
        sh:namespace "http://example.org/example/ldio/" ;
    ] ,
    [
        sh:prefix "mu" ;
        sh:namespace "http://mu.semte.ch/vocabularies/core/" ;
    ] ,
    [
        sh:prefix "nfo" ;
        sh:namespace "http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#" ;
    ] ,
    [
        sh:prefix "owl" ;
        sh:namespace "http://www.w3.org/2002/07/owl#" ;
    ] ,
    [
        sh:prefix "p-plan" ;
        sh:namespace "http://purl.org/net/p-plan#" ;
    ] ,
    [
        sh:prefix "proc" ;
        sh:namespace "http://dishacled.example.org/processors#" ;
    ] ,
    [
        sh:prefix "prov" ;
        sh:namespace "http://www.w3.org/ns/prov#" ;
    ] ,
    [
        sh:prefix "rdf" ;
        sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ;
    ] ,
    [
        sh:prefix "rdfc" ;
        sh:namespace "https://w3id.org/rdf-connect#" ;
    ] ,
    [
        sh:prefix "rdfs" ;
        sh:namespace "http://www.w3.org/2000/01/rdf-schema#" ;
    ] ,
    [
        sh:prefix "sh" ;
        sh:namespace "http://www.w3.org/ns/shacl#" ;
    ] ,
    [
        sh:prefix "spdx" ;
        sh:namespace "http://spdx.org/rdf/terms#" ;
    ] ,
    [
        sh:prefix "sw" ;
        sh:namespace "https://semantic.works/services/" ;
    ] ,
    [
        sh:prefix "tcs" ;
        sh:namespace "https://w3id.org/toolchain#" ;
    ] ,
    [
        sh:prefix "tm" ;
        sh:namespace "https://w3id.org/rdf-connect/threshold-monitor#" ;
    ] ,
    [
        sh:prefix "xsd" ;
        sh:namespace "http://www.w3.org/2001/XMLSchema#" ;
    ] .


#################################################################
# Local tcs:Config subclasses
#
# Two of `sw:mu-cl-resources`'s config files share `dct:format
# "text/x-common-lisp"`. The subclass distinction below lets the
# per-service compiler pick the right one for each output filename.
#################################################################

tcs:ResourcesDomainConfig
    a rdfs:Class ;
    rdfs:subClassOf tcs:Config ;
    rdfs:label "mu-cl-resources domain.lisp config" ;
    rdfs:comment "Marker subclass for the Lisp file that mu-cl-resources loads as domain.lisp (declares prefixes and calls read-domain-file)." .

tcs:ResourcesRepositoryConfig
    a rdfs:Class ;
    rdfs:subClassOf tcs:Config ;
    rdfs:label "mu-cl-resources repository.lisp config" ;
    rdfs:comment "Marker subclass for the Lisp file that mu-cl-resources loads as repository.lisp (declares runtime settings)." .


#################################################################
# rdfc:SPARQLIngest — outer shape and its nested config shape.
# The outer shape uses a SHACL SPARQL target to walk from the step
# through its embedded pipeline config, so `sh:targetObjectsOf` alone
# is not expressive enough.
#################################################################

:SparqlIngestShape a sh:NodeShape;
      sh:target [
        a sh:SPARQLTarget ;
        sh:prefixes :prefixes ;
        sh:select """
            SELECT ?this WHERE {
                ?step prov:specializationOf rdfc:SPARQLIngest ;
                      p-plan:hasInputVar/tcs:embedded ?this .
            }
        """
    ] ;
  sh:property [
    sh:path rdfc:memberStream;
    sh:name "memberStream";
    sh:class tcs:Channel;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path rdfc:ingestConfig;
    sh:name "config";
    sh:node :SparqlIngestConfigShape;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path rdfc:sparqlWriter;
    sh:name "sparqlWriter";
    sh:class tcs:Channel;
    sh:maxCount 1;
  ].


:SparqlIngestConfigShape a sh:NodeShape;
  sh:targetObjectsOf rdfc:ingestConfig;
  sh:property [
    sh:path rdfc:operationMode;
    sh:datatype xsd:string;
    sh:name "operationMode";
    sh:maxCount 1;
  ], [
    sh:path rdfc:memberBatchSize;
    sh:datatype xsd:integer;
    sh:name "memberBatchSize";
    sh:maxCount 1;
  ], [
    sh:path rdfc:memberShape;
    sh:datatype xsd:string;
    sh:name "memberShape";
    sh:maxCount 1;
  ], [
    sh:path rdfc:changeSemantics;
    sh:class rdfc:ChangeSemantics;
    sh:name "changeSemantics";
    sh:maxCount 1;
    sh:minCount 0;
  ], [
    sh:path rdfc:targetNamedGraph;
    sh:datatype xsd:string;
    sh:name "targetNamedGraph";
    sh:maxCount 1;
    sh:minCount 0;
  ], [
    sh:path rdfc:transactionConfig;
    sh:class rdfc:TransactionConfig;
    sh:name "transactionConfig";
    sh:maxCount 1;
    sh:minCount 0;
  ], [
    sh:path rdfc:graphStoreUrl;
    sh:datatype xsd:string;
    sh:name "graphStoreUrl";
    sh:maxCount 1;
    sh:minCount 0;
  ], [
    sh:path rdfc:forVirtuoso;
    sh:datatype xsd:boolean;
    sh:name "forVirtuoso";
    sh:maxCount 1;
    sh:minCount 0;
  ], [
    sh:path rdfc:accessToken;
    sh:datatype xsd:string;
    sh:name "accessToken";
    sh:maxCount 1;
    sh:minCount 0;
  ], [
    sh:path rdfc:measurePerformance;
    sh:class rdfc:PerformanceConfig;
    sh:name "measurePerformance";
    sh:maxCount 1;
    sh:minCount 0;
  ].
