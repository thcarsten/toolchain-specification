#################################################################
# Catalog — core component definitions
#
# One block per pipeline component: types, labels, `dct:requires`
# (both component→component and component→spdx:Package), `ldio:type`,
# `owl:imports`, `spdx:versionInfo`, `tcs:config` pointing at the
# named config bodies in catalog-configs.ttl, `dcat:qualifiedRelation`
# pointing at shapes in catalog-shapes.ttl.
#
# Meant to be loaded together with catalog-configs.ttl and
# catalog-shapes.ttl.
#################################################################


#################################################################
# Prefixes
#################################################################

@prefix : <http://example.org/example/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/>.
@prefix ldio: <http://example.org/example/ldio/> .
@prefix mu: <http://mu.semte.ch/vocabularies/core/>.
@prefix nfo: <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#>.
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix p-plan: <http://purl.org/net/p-plan#> .
@prefix proc: <http://dishacled.example.org/processors#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfc: <https://w3id.org/rdf-connect#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix sw: <https://semantic.works/services/> .
@prefix tcs: <https://w3id.org/toolchain#> .
@prefix tm: <https://w3id.org/rdf-connect/threshold-monitor#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .


#################################################################
# Package managers
#################################################################

# This is a stub
:pip rdfs:label "pip" ;
rdfs:comment "Python package manager. Packages annotated with this end up in pyproject.toml." .

:npm rdfs:label "npm" ;
rdfs:comment "Node.js package manager. Packages annotated with this end up in package.json." .


#################################################################
# Catalog
#################################################################

:DishacledCatalog
  a dcat:Catalog;
  dct:title "Datasets and processors used in DiSHACLed demonstrator.";
  dcat:dataset :waterLevelsInCm, :waterLevelsInMm ;
  dcat:resource
    # LDIO  
    ldio:HttpInPoller,
    ldio:RmlAdapter, 
    ldio:RdfAdapter, 
    ldio:JsonToLdAdapter,
    ldio:SparqlConstructTransformer,
    ldio:ConsoleOut,
    ldio:HttpOut, 
    ldio:HttpIn,
    ldio:LinkedDataInteractionsOrchestrator,
    ldio:LdioPipelineStarterService,
    # RDF Connect
    rdfc:HttpFetch,
    rdfc:HttpIn,
    rdfc:HttpServer,
    rdfc:Sdsify,
    rdfc:SkolemizationProcessor,
    rdfc:LogProcessorJs,
    rdfc:thresholdMonitoringProcessor,
    rdfc:SPARQLIngest,
    rdfc:LogProcessorPy,
    rdfc:HttpOut,
    rdfc:NodeRunner,
    rdfc:PyRunner,
    rdfc:Orchestrator,
    tm:ThresholdMonitorJs,
    proc:JsonLdToNQuads,
    # Semantic works
    sw:loket-error-alert-service,
    sw:deliver-email-service ,
    sw:triple-store,
    sw:mu-identifier,
    sw:mu-dispatcher,
    sw:mu-cl-resources,
    sw:mu-delta-notifier,
    sw:mu-authorization .


#################################################################
# Datasets
#################################################################

# Source dataset published by the mock JSON-LD APIs, but could also be others like LDES or SPARQL
:waterLevelsInCm a dcat:Dataset ;
  dct:conformsTo :waterLevelsInCmShape .

:waterLevelsInMm a dcat:Dataset ;
  dct:conformsTo :waterLevelsInMmShape .

# The mock JSON-LD APIs
:rawDataStreamInCm a dcat:DataService ;
  dcat:servesdataset :waterLevelsInCm ;
  # Optional, because dataset already provides this shape
  dcat:qualifiedRelation [
        a dcat:Relationship;
        dcat:hadRole :outputShape ;
        dct:relation :waterLevelsInCmShape
    ] .

:rawDataStreamInMm a dcat:Service ;
  dcat:servesdataset :waterLevelsInMm ;
  # Optional, because dataset already provides this shape
  dcat:qualifiedRelation [
        a dcat:Relationship;
        dcat:hadRole :outputShape ;
        dct:relation :waterLevelsInMmShape
    ] .


#################################################################
# LDIO Components
#################################################################

ldio:HttpInPoller a tcs:PipelineComponent, dcat:Resource;
    rdfs:label "Ldio:HttpInPoller" ; 
    ldio:type "Input" ;
    dcat:landingPage "https://informatievlaanderen.github.io/VSDS-Linked-Data-Interactions/2.8.0-SNAPSHOT/ldio/ldio-inputs/ldio-http-in-poller" ;
    dct:requires ldio:LinkedDataInteractionsOrchestrator .


ldio:RdfAdapter a tcs:PipelineComponent, dcat:Resource;
    rdfs:label "Ldio:RdfAdapter" ; 
    ldio:type "Adapter" ;
    dcat:landingPage "https://informatievlaanderen.github.io/VSDS-Linked-Data-Interactions/2.8.0-SNAPSHOT/ldio/ldio-adapters/ldio-rdf-adapter" ;
    dct:requires ldio:LinkedDataInteractionsOrchestrator .


ldio:SparqlConstructTransformer 
    a tcs:PipelineComponent, dcat:Resource ;
    rdfs:label "Ldio:SparqlConstructTransformer" ; 
    ldio:type "Transformer" ;
    dct:requires ldio:LinkedDataInteractionsOrchestrator .


ldio:HttpOut a tcs:PipelineComponent, dcat:Resource;
    rdfs:label "Ldio:HttpOut" ; 
    rdfs:description "The LDIO HTTP Out is a basic Http Client that will send the given Linked Data model to a target url.";
    ldio:type "Output" ;
    dcat:landingPage "https://informatievlaanderen.github.io/VSDS-Linked-Data-Interactions/2.8.0-SNAPSHOT/ldio/ldio-outputs/ldio-http-out" ;
    dct:requires ldio:LinkedDataInteractionsOrchestrator . 


ldio:LinkedDataInteractionsOrchestrator
    a tcs:PipelineComponent, dcat:Resource ;
    rdfs:label "Linked Data Interactions Orchestrator" ;
    dcat:landingPage "https://informatievlaanderen.github.io/VSDS-Linked-Data-Interactions/2.8.0-SNAPSHOT/" ;
    spdx:versionInfo "2.8.0-SNAPSHOT";
    tcs:config :LdioDefaultDockerComposeConfig ;
    dct:requires ldio:LdioPipelineStarterService .


ldio:LdioPipelineStarterService 
    a tcs:PipelineComponent, dcat:Resource ;
    rdfs:label "Ldio Pipeline Starter Service" ;
    tcs:config :LdioPipelineStarterDockerComposeConfig . 


# The source-a API serves JSON-LD bodies with `Content-Type: application/json`.
# `ldio:RdfAdapter` refuses that content-type; `ldio:JsonToLdAdapter` accepts
# it when `force-content-type: true` is set and applies an inline JSON-LD
# `context` to re-expand terms.
ldio:JsonToLdAdapter a tcs:PipelineComponent, dcat:Resource ;
    rdfs:label "Ldio:JsonToLdAdapter" ;
    ldio:type "Adapter" ;
    dcat:landingPage "https://informatievlaanderen.github.io/VSDS-Linked-Data-Interactions/2.13.0/ldio/ldio-adapters/ldio-json-to-json-ld" ;
    dct:requires ldio:LinkedDataInteractionsOrchestrator .


#################################################################
# RDF Connect Components
#################################################################

rdfc:SPARQLIngest a tcs:PipelineComponent, dcat:Resource;
    rdfs:label "Sparql Ingest";
    rdfs:description "This processor takes a stream of RDF records, transforms them into corresponding SPARQL Update queries, and executes them against a SPARQL Graph Store via the SPARQL Protocol." ; 
    dcat:landingPage "https://github.com/rdf-connect/sparql-ingest-processor-ts";
    dct:requires rdfc:NodeRunner;
    dct:requires [
        a spdx:Package ;
        spdx:name "@rdfc/sparql-ingest-processor-ts" ;
        spdx:versionInfo "^2.1.7" ;
        spdx:suppliedBy :npm
    ];
    owl:imports <./node_modules/@rdfc/sparql-ingest-processor-ts/processors.ttl> ;
    dcat:qualifiedRelation [
      dct:relation :SparqlIngestShape, :SparqlIngestConfigShape;
      dcat:hadRole "configShape" ;
    ] .


rdfc:HttpIn a tcs:PipelineComponent, dcat:Resource;
    rdfs:label "RDF Connect Http In";
    dct:requires rdfc:PyRunner;
    owl:imports <../../../usr/local/lib/python3.13/site-packages/rdfc_http_in/processor.ttl> . # I still need to build this component


rdfc:HttpOut a tcs:PipelineComponent, dcat:Resource;
    rdfs:label "RDF Connect Http Out";
    dct:requires rdfc:PyRunner;
    dct:requires [
        a spdx:Package ;
        spdx:name "rdfc_http_out" ;
        spdx:downloadLocation "file:///workspace/pipeline/local_processors/rdfc_http_out" ;
        spdx:suppliedBy :pip
    ] ;
    owl:imports <../../../usr/local/lib/python3.13/site-packages/rdfc_http_out/processor.ttl> . 


rdfc:thresholdMonitoringProcessor a :PipelineComponent, dcat:Resource ; # I still need to build this component
  dct:requires rdfc:NodeRunner ;
  owl:imports <../../../usr/local/lib/python3.13/site-packages/rdfc_threshold_monitoring/processor.ttl> . 


rdfc:NodeRunner a tcs:PipelineComponent, rdfc:Runner, dcat:Resource;
    rdfs:label "RDF Connect Javascript Node Runner" ; 
    dct:requires rdfc:Orchestrator ;
    dct:requires [
        a spdx:Package ;
        spdx:name "@rdfc/js-runner" ;
        spdx:versionInfo "^3.2.0" ;
        spdx:suppliedBy :npm
    ];
    owl:imports <./node_modules/@rdfc/js-runner/index.ttl> . # This is specific to RDF Connect


rdfc:PyRunner a tcs:PipelineComponent, rdfc:Runner, dcat:Resource;
    rdfs:label "RDF Connect Python Runner" ; 
    dct:requires rdfc:Orchestrator ;
    dct:requires [
        a spdx:Package ;
        spdx:name "rdfc-runner" ;
        spdx:versionInfo ">=1.0.0" ;
        spdx:suppliedBy :pip
    ]; 
    owl:imports <../../../usr/local/lib/python3.13/site-packages/rdfc_runner/index.ttl> . 


rdfc:Orchestrator a tcs:PipelineComponent, dcat:Resource ;
    rdfs:label "RDF Connect Orchestrator" ;
    dct:requires [
        a spdx:Package ;
        spdx:name "rdfc-proto" ;
        spdx:versionInfo ">=1.0.0" ;
        spdx:suppliedBy :pip
    ]; 
    dct:requires [
        a spdx:Package ;
        spdx:name "@rdfc/orchestrator-js" ;
        spdx:versionInfo "^2.2.1" ;
        spdx:suppliedBy :npm
    ]; 
    tcs:config :RdfcOrchestratorDockerCompose ,
               :RdfcOrchestratorDockerImage .


# HTTP ingest server. The demonstrator switched from the pull-based
# `rdfc:HttpFetch`/`rdfc:HttpIn` to an accept-a-POST server so the LDIO
# workbench can push enriched observations to `http://rdfc:9000/source-a`.
rdfc:HttpServer a tcs:PipelineComponent, dcat:Resource ;
    rdfs:label "RDF Connect HTTP Server" ;
    rdfs:description "Receives POSTed RDF (or JSON-LD) payloads at a configurable path and writes them onto an outgoing channel." ;
    dcat:landingPage "https://github.com/rdf-connect/http-utils-processor-ts" ;
    dct:requires rdfc:NodeRunner ;
    dct:requires [
        a spdx:Package ;
        spdx:name "@rdfc/http-utils-processor-ts" ;
        spdx:versionInfo "^1.2.0-alpha.1" ;
        spdx:suppliedBy :npm
    ] ;
    owl:imports <./node_modules/@rdfc/http-utils-processor-ts/processors.ttl> .


# Streaming envelope. Wraps each entity of a given type
# (e.g. `sosa:Observation`) as an SDS record, and emits stream metadata
# on a paired `metadataOutput` channel.
rdfc:Sdsify a tcs:PipelineComponent, dcat:Resource ;
    rdfs:label "RDF Connect Sdsify" ;
    rdfs:description "Wraps typed subgraphs as SDS records for downstream stream processors." ;
    dcat:landingPage "https://github.com/rdf-connect/sds-processors-ts" ;
    dct:requires rdfc:NodeRunner ;
    dct:requires [
        a spdx:Package ;
        spdx:name "@rdfc/sds-processors-ts" ;
        spdx:versionInfo "^3.0.1" ;
        spdx:suppliedBy :npm
    ] ;
    owl:imports <./node_modules/@rdfc/sds-processors-ts/configs/sdsify.ttl> .


# Skolemization. Rewrites blank-node subjects to fresh named IRIs so
# downstream `rdfc:Sdsify` (which only extracts members with URIRef subjects)
# can process `oslc:Error` payloads emitted by the threshold monitor.
rdfc:SkolemizationProcessor a tcs:PipelineComponent, dcat:Resource ;
    rdfs:label "RDF Connect Skolemization Processor" ;
    dcat:landingPage "https://github.com/rdf-connect/skolemization-processor-ts" ;
    dct:requires rdfc:NodeRunner ;
    dct:requires [
        a spdx:Package ;
        spdx:name "@rdfc/skolemization-processor-ts" ;
        spdx:versionInfo "^1.0.0" ;
        spdx:suppliedBy :npm
    ] ;
    owl:imports <./node_modules/@rdfc/skolemization-processor-ts/processor.ttl> .


# Log processor. Terminal step that drains a channel to the container
# log — used in the demonstrator to consume Sdsify's mandatory-but-unused
# metadata sidechannels.
rdfc:LogProcessorJs a tcs:PipelineComponent, dcat:Resource ;
    rdfs:label "RDF Connect Log Processor (JS)" ;
    dcat:landingPage "https://github.com/rdf-connect/log-processor-ts" ;
    dct:requires rdfc:NodeRunner ;
    dct:requires [
        a spdx:Package ;
        spdx:name "@rdfc/log-processor-ts" ;
        spdx:versionInfo "^2.0.3" ;
        spdx:suppliedBy :npm
    ] ;
    owl:imports <./node_modules/@rdfc/log-processor-ts/processor.ttl> .


# Threshold monitor (JS implementation). Replaces the stub
# `rdfc:thresholdMonitoringProcessor` above — the demonstrator targets
# `tm:ThresholdMonitorJs` from the `tm:` namespace, with additional
# per-run configuration on `tm:stream` / `tm:creator` / `tm:path`.
tm:ThresholdMonitorJs a tcs:PipelineComponent, dcat:Resource ;
    rdfs:label "Threshold Monitor (JS)" ;
    rdfs:description "Compares a numeric value along an RDF path on each incoming SDS member against configurable min/max bounds; emits an oslc:Error on violation." ;
    dcat:landingPage "https://github.com/rdf-connect/threshold-monitor-processor-ts" ;
    dct:requires rdfc:NodeRunner ;
    dct:requires [
        a spdx:Package ;
        spdx:name "@rdfc/threshold-monitor-processor-ts" ;
        spdx:versionInfo "^0.0.1-alpha.2" ;
        spdx:suppliedBy :npm
    ] ;
    owl:imports <./node_modules/@rdfc/threshold-monitor-processor-ts/processor.ttl> .


# Custom local processor. Converts incoming JSON-LD bytes to N-Quads
# for the SDS tooling downstream. Not published on npm — the source lives
# in the demonstrator repo at `demonstrator/RDFC/processors/jsonld-to-nquads/`
# and is copied into the RDFC container at build time.
proc:JsonLdToNQuads a tcs:PipelineComponent, dcat:Resource ;
    rdfs:label "JSON-LD to N-Quads converter" ;
    rdfs:description "Locally-built RDF-Connect processor that parses JSON-LD bytes on the input channel into N-Quads on the output channel." ;
    dct:requires rdfc:NodeRunner ;
    dct:requires [
        a spdx:Package ;
        spdx:name "jsonld-to-nquads" ;
        spdx:downloadLocation "file:///workspace/pipeline/processors/jsonld-to-nquads" ;
        spdx:suppliedBy :npm
    ] ;
    dct:requires [
        a spdx:Package ;
        spdx:name "jsonld" ;
        spdx:versionInfo "^9.0.0" ;
        spdx:suppliedBy :npm
    ] ;
    owl:imports <./processors/jsonld-to-nquads/processor.ttl> .


#################################################################
# Semantic.works — visible services
#################################################################

sw:loket-error-alert-service a tcs:PipelineComponent, mu:Microservice, dcat:Resource ;
  rdfs:description "Service that is responsible for sending out alerts when errors are inserted in the store. Build using the MU Javascript template.";
  dcat:landingPage <https://github.com/lblod/loket-error-alert-service> ;
  dct:requires sw:triple-store ,
               sw:mu-delta-notifier ,
               sw:mu-identifier ;
  tcs:config :LoketErrorAlertServiceDockerCompose ,
             :ErrorAlertConfigJsonDefault ,
             :ErrorAlertTemplateHbsDefault .


sw:deliver-email-service a tcs:PipelineComponent, mu:Microservice, dcat:Resource ;
  rdfs:description "Microservice that delivers emails from a mail folder" ;
  dcat:landingPage <https://github.com/lblod/berichtencentrum-deliver-email-service> ;
  dct:requires sw:triple-store ,
               sw:mu-identifier ;
  tcs:config :DeliverEmailServiceDockerCompose .


sw:triple-store a tcs:PipelineComponent, dcat:Resource;
  dcat:landingPage <https://virtuoso.dev/react-virtuoso/> ;
  tcs:config :TripleStoreDockerCompose ,
             :VirtuosoIniDefault .


#################################################################
# Semantic.works — mu-semtech infrastructure services
#
# The demonstrator's `docker-compose-sw.yml` deploys a full mu stack.
# The three sw components above (`loket-error-alert-service`,
# `deliver-email-service`, `triple-store`) cover the visible endpoints;
# the routing / auth / delta infrastructure below is needed so the
# generator emits a compose file that actually boots the stack.
#
# These are **infrastructure** components — they don't correspond to
# `InstancePipelineComponent` steps. They exist purely to satisfy
# `dct:requires` chains from the components that *do* have steps
# (loket-error-alert-service → triple-store → delta-notifier → identifier).
#################################################################

sw:mu-identifier a tcs:PipelineComponent, mu:Microservice, dcat:Resource ;
    rdfs:description "SPARQL gateway. Front door for every SPARQL update / query in the mu stack; adds the session cookie header used by the authorisation layer." ;
    dcat:landingPage <https://github.com/mu-semtech/mu-identifier> ;
    dct:requires sw:mu-dispatcher ;
    tcs:config :MuIdentifierDockerCompose .


sw:mu-dispatcher a tcs:PipelineComponent, mu:Microservice, dcat:Resource ;
    rdfs:description "HTTP routing. Dispatches incoming requests to the right microservice based on `config/dispatcher/dispatcher.ex`." ;
    dcat:landingPage <https://github.com/mu-semtech/mu-dispatcher> ;
    dct:requires sw:mu-authorization ,
                 sw:mu-cl-resources ;
    tcs:config :MuDispatcherDockerCompose ,
               :MuDispatcherExDefault .


sw:mu-cl-resources a tcs:PipelineComponent, mu:Microservice, dcat:Resource ;
    rdfs:description "JSON-API layer over the triple store. Serves the domain model declared in `config/resources/`." ;
    dcat:landingPage <https://github.com/mu-semtech/mu-cl-resources> ;
    dct:requires sw:mu-authorization ;
    tcs:config :MuClResourcesDockerCompose ,
               :MuResourcesDomainJsonDefault ,
               :MuResourcesDomainLispDefault ,
               :MuResourcesRepositoryLispDefault .


sw:mu-delta-notifier a tcs:PipelineComponent, mu:Microservice, dcat:Resource ;
    rdfs:description "Pub/sub bus. Watches SPARQL updates on the shared store and fires per-service webhooks per `config/delta/rules.js` — the mechanism that lets `error-alert` react to a fresh `oslc:Error` insertion." ;
    dcat:landingPage <https://github.com/mu-semtech/mu-delta-notifier> ;
    dct:requires sw:triple-store ;
    tcs:config :MuDeltaNotifierDockerCompose ,
               :MuDeltaNotifierRulesJsDefault .


sw:mu-authorization a tcs:PipelineComponent, mu:Microservice, dcat:Resource ;
    rdfs:description "SPARQL parser + authorisation gate. Enforces the ACL declared in `config/authorization/config.lisp`." ;
    dcat:landingPage <https://github.com/mu-semtech/mu-authorization> ;
    dct:requires sw:triple-store ;
    tcs:config :MuAuthorizationDockerCompose ,
               :MuAuthorizationConfigLispDefault .
