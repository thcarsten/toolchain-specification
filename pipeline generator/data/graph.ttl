@prefix : <http://example.org/example/> .
@prefix tc: <https://w3id.org/toolchain#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix osw: <http://ontosoft.org/software#> .
@prefix dct: <http://purl.org/dc/terms/>.
@prefix ext: <http://mu.semte.ch/vocabluries/ext/>.
@prefix mu: <http://mu.semte.ch/vocabularies/core/>.
@prefix nfo: <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#>.
@prefix nie: <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sw: <https://semantic.works/services/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix ldio: <http://example.org/example/ldio/> .
@prefix rdfc: <https://w3id.org/rdf-connect#> .
@prefix p-plan: <http://purl.org/net/p-plan#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .


#################################################################
# Catalog members
#################################################################

:DishacledCatalog
  a dcat:Catalog, tc:ComponentCatalog;
  dct:title "Dishacled Catalog";
  dct:description "A small collection of Pipeline Components needed for the demonstrator.";
  dcat:resource
    # LDIO  
    ldio:HttpInPoller,
    ldio:RmlAdapter, 
    ldio:LdesClient, 
    ldio:SparqlConstructTransformer,
    ldio:ConsoleOut,
    ldio:HttpOut, 
    ldio:HttpIn,
    ldio:LinkedDataInteractionsOrchestrator,
    ldio:LdioPipelineStarterService,
    # RDF Connect
    rdfc:HttpFetch,
    rdfc:HttpIn,
    rdfc:ThresholdMonitoring,
    rdfc:SparqlIngest,
    rdfc:LdesClient,
    rdfc:LogProcessorPy,
    rdfc:HttpOut,
    rdfc:NodeRunner,
    rdfc:PyRunner,
    rdfc:Orchestrator, 
    # Semantic works
    sw:loket-error-alert-service,
    sw:deliver-email-service ,
    sw:delta-notifier,
    sw:triplestore .


#################################################################
# Pipeline definitions
#################################################################

### Simple Ldio Pipeline ### 

:LdioPipeline a tc:PipelineDefinition;
    rdfs:label "Simple Ldio pipeline.";
    rdfs:comment "Regularly polls an API and prints response to console.".

:LdioPollApiStep p-plan:isStepOfPlan :LdioPipeline .
:LdioConsoleOutStep p-plan:isStepOfPlan :LdioPipeline .
:LdioConsoleOutStep p-plan:isPrecededBy :LdioPollApiStep .

:LdioPollApiStep a tc:PipelineStep ;
  p-plan:hasInputVar [
    tc:component ldio:HttpInPoller ;
    tc:config :DishacledApiConfig
] .

:LdioConsoleOutStep a tc:PipelineStep ;
  p-plan:hasInputVar [
    tc:component ldio:ConsoleOut ;
] .


### Simple Rdf Connect Pipeline ### 

:RdfcPipeline a tc:PipelineDefinition;
    rdfs:label "Simple RDF Connect pipeline.";
    rdfs:comment "Regularly polls an API and prints response to console.".

:RdfcPollApiStep p-plan:isStepOfPlan :RdfcPipeline .
:RdfcConsoleOutStep p-plan:isStepOfPlan :RdfcPipeline .
:RdfcConsoleOutStep p-plan:isPrecededBy :RdfcPollApiStep .

:RdfcPollApiStep a tc:PipelineStep ;
  p-plan:hasInputVar [
    tc:component rdfc:HttpFetch ;
    tc:config :DishacledApiConfig ;
] .

:RdfcConsoleOutStep a tc:PipelineStep ;
  p-plan:hasInputVar [
    tc:component rdfc:LogProcessorPy ;
    tc:config 
        [ 
            a tc:PipelineConfig ;
                tc:embedded [
                    rdfc:level "debug";
                    rdfc:label "test"
                ] 
        ]
] .

:DishacledApiConfig a tc:PipelineConfig ;
    tc:embedded # This is a very rare example of how 1 Config can be used for 2 different processors (In case of Ldio, the prefixes are simply dropped )
        [
            rdfc:url "https://dishacled-api.azurewebsites.net/api/v1/source-a/current" ;
            rdfc:cron "*/10 * * * * *" # Every 10 seconds
] .


### Interoperable Pipeline ###

:InteroperablePipeline a tc:PipelineDefinition;
    rdfs:label "Interoperable Pipeline";
    rdfs:comment "Pipeline spanning LDIO and RDF Connect.".

# Here I can simply reuse some steps that I defined earlier
:RdfcPollApiStep p-plan:isStepOfPlan :InteroperablePipeline .
:RdfcHttpOutStep  p-plan:isStepOfPlan :InteroperablePipeline .
:LdioHttpInStep  p-plan:isStepOfPlan :InteroperablePipeline .
:LdioConsoleOutStepInter p-plan:isStepOfPlan :InteroperablePipeline .
:LdioConsoleOutStepInter p-plan:isPrecededBy :LdioHttpInStep.
:LdioHttpInStep p-plan:isPrecededBy :RdfcHttpOutStep .
:RdfcHttpOutStep p-plan:isPrecededBy :RdfcPollApiStep .


:LdioConsoleOutStepInter a tc:PipelineStep ;
  p-plan:hasInputVar [
    tc:component ldio:ConsoleOut ;
    tc:config 
        [
            a tc:PipelineConfig;
            tc:embedded 
            [
            :rdf-writer 
                [:content-type "text/turtle"] ;
            ] 
        ] 
] .



:RdfcHttpOutStep a tc:PipelineStep ;
    p-plan:hasInputVar [
        tc:component rdfc:HttpOut ;
        tc:config 
            [ 
                a tc:PipelineConfig ;
                    tc:embedded [
                        rdfc:endpoint "http://ldio-workbench:8080/LdioHttpInPipeline";
                    ] 
            ]
] .


:LdioHttpInStep a tc:PipelineStep ;
    p-plan:hasInputVar [
            tc:component ldio:HttpIn ;
] .


# This is a special one. It attaches an Assignment directly to the pipeline definition, making sure that the ldio-workbench is reachable with the right endpoint: http://ldio-workbench:8080/LdioHttpInPipeline
:CorrectEndpointAssignment a tc:Assignment ;
    p-plan:isVariableOfPlan :InteroperablePipeline ;
    tc:component ldio:LinkedDataInteractionsOrchestrator ;
    tc:config :LdioDefaultDockerComposeConfig ,
    [ 
        a tc:PipelineConfig ;
        tc:embedded [
            :name "LdioHttpInPipeline";
        ] 
] .


#################################################################
# LDIO components
#################################################################

ldio:HttpIn a tc:PipelineComponent;
    rdfs:label "Ldio:HttpIn" ; 
    rdfs:description "The LDIO Http In is a basic Http Listener. Data can be written to http://{hostname}:{port}/{pipeline name}" ;
    ldio:type "Input" ;
    osw:hasProjectWebsite "https://informatievlaanderen.github.io/VSDS-Linked-Data-Interactions/2.8.0-SNAPSHOT/ldio/ldio-inputs/ldio-http-in" ;
    dct:requires [
        tc:component ldio:LinkedDataInteractionsOrchestrator ;
        tc:config [ # This tells the PipelineGenerator that the HttpInPoller expects the config of ldio:LinkedDataInteractionsOrchestrator to have a specific entry
            a tc:PipelineConfig ;
            tc:embedded [
                :input
                    [ :name "Ldio:HttpIn" ]
            ]
        ]
    ] .


ldio:HttpInPoller a tc:PipelineComponent;
    rdfs:label "Ldio:HttpInPoller" ; 
    ldio:type "Input" ;
    osw:hasProjectWebsite "https://informatievlaanderen.github.io/VSDS-Linked-Data-Interactions/2.8.0-SNAPSHOT/ldio/ldio-inputs/ldio-http-in-poller" ;
    dct:requires [
        tc:component ldio:LinkedDataInteractionsOrchestrator ;
        tc:config [ # This tells the PipelineGenerator that the HttpInPoller expects the config of ldio:LinkedDataInteractionsOrchestrator to have a specific entry
            a tc:PipelineConfig ;
            tc:embedded [
                :input
                    [ :name "Ldio:HttpInPoller" ]
            ]
        ]
    ] .


ldio:HttpOut a tc:PipelineComponent;
    rdfs:label "Ldio:HttpOut" ; 
    rdfs:description "The LDIO HTTP Out is a basic Http Client that will send the given Linked Data model to a target url.";
    ldio:type "Output" ;
    osw:hasProjectWebsite "https://informatievlaanderen.github.io/VSDS-Linked-Data-Interactions/2.8.0-SNAPSHOT/ldio/ldio-outputs/ldio-http-out" ;
    dct:requires [
        tc:component ldio:LinkedDataInteractionsOrchestrator ;
        tc:config [ # This tells the PipelineGenerator that the HttpInPoller expects the config of ldio:LinkedDataInteractionsOrchestrator to have a specific entry
            a tc:PipelineConfig ;
            tc:literal """
outputs:
    - name: Ldio:HttpOut
""" ]
    ] ;
    dcat:qualifiedRelation [
        dct:relation :LdioHttpOutConfigShape ;
        dcat:hadRole :configShape ; 
] . 


:LdioHttpOutConfigShape a sh:NodeShape;
    sh:targetClass tc:PipelineConfig;
    sh:property [
        sh:path :endpoint;
        sh:name "endpoint";
        sh:datatype xsd:string;
        sh:minCount 1;
].


ldio:ConsoleOut a tc:PipelineComponent;
    rdfs:label "Ldio:ConsoleOut" ; 
    ldio:type "Output" ;
    osw:hasProjectWebsite "https://informatievlaanderen.github.io/VSDS-Linked-Data-Interactions/2.8.0-SNAPSHOT/ldio/ldio-outputs/ldio-console-out" ;
    dct:requires [
        tc:component ldio:LinkedDataInteractionsOrchestrator ;
        tc:config [ # This tells the PipelineGenerator that the HttpInPoller expects the config of ldio:LinkedDataInteractionsOrchestrator to have a specific entry
            a tc:PipelineConfig ;
            tc:literal """
outputs:
    - name: Ldio:ConsoleOut
"""
        ]
    ] .


ldio:LinkedDataInteractionsOrchestrator
    a tc:PipelineComponent ;
    rdfs:label "Linked Data Interactions Orchestrator" ;
    osw:hasProjectWebsite "https://informatievlaanderen.github.io/VSDS-Linked-Data-Interactions/2.8.0-SNAPSHOT/" ;
    osw:hasSoftwareVersion [
          osw:hasVersionId "2.8.0-SNAPSHOT"
          ] ;
    tc:config :LdioDefaultDockerComposeConfig ;
    dct:requires [tc:component ldio:LdioPipelineStarterService] .


:LdioDefaultDockerComposeConfig
    a tc:Config, tc:DefaultConfig, tc:DockerComposeConfig ;
    tc:literal """
ldio-workbench:
    container_name: ldio-workbench
    image: ldes/ldi-orchestrator:2.8.0-SNAPSHOT
    ports:
      - "8080:8080"
""" .


ldio:LdioPipelineStarterService 
    a tc:PipelineComponent ;
    rdfs:label "Ldio Pipeline Starter Service" ;
    tc:config [
        a tc:DefaultConfig, tc:DockerComposeConfig ;
        tc:literal '''
ldio-pipeline-starter:
    image: curlimages/curl
    volumes:
      - ./ldio_pipeline.yml:/pipeline.yml:ro
    command: >
      sh -c "
      sleep 30 &&
      curl -X POST
      -H 'content-type: application/yaml'
      http://ldio-workbench:8080/admin/api/v1/pipeline
      --data-binary @/pipeline.yml
      "         
''' ] .


#################################################################
# RDF Connect components
#################################################################


rdfc:HttpFetch
    a tc:PipelineComponent, rdfc:Processor ;
    rdfs:label "HTTP Fetch processor";
    rdfs:description "This processor fetches a URL and writes the response to the output channel. It supports various options such as HTTP method, headers, authentication, and scheduling with cron expressions.";
    osw:hasProjectWebsite "https://github.com/rdf-connect/http-utils-processor-ts" ;
    dct:requires [tc:component rdfc:NodeRunner ] ,
    [
        tc:component rdfc:Orchestrator ;
        tc:config [
            a tc:PipelineConfig ; 
            tc:embedded [ owl:imports <./node_modules/@rdfc/http-utils-processor-ts/processors.ttl> ]
        ];
    ] ;
    dcat:qualifiedRelation [
        dct:relation :HttpFetchConfigShape ;
        dcat:hadRole :configShape ; 
    ] . 


rdfc:HttpOut a tc:PipelineComponent;
    rdfs:label "RDF Connect Http Out";
    dct:requires [tc:component rdfc:PyRunner],
    [
        tc:component rdfc:Orchestrator ;
        tc:config [
            a tc:PipelineConfig ; 
            tc:embedded [ owl:imports <../../../usr/local/lib/python3.13/site-packages/rdfc_http_out/processor.ttl> ]
        ];
    ] ;
    dcat:qualifiedRelation [
        dct:relation :RdfcHttpOutConfigShape ;
        dcat:hadRole :configShape ; 
    ] ;
    .

:RdfcHttpOutConfigShape a sh:NodeShape;
    sh:targetClass tc:PipelineConfig;
        sh:node [
            sh:property [
                sh:class rdfc:Reader;
                sh:path rdfc:reader;
                sh:name "reader";
                sh:minCount 1;
                sh:maxCount 1;
            ] , [
                sh:datatype xsd:string;
                sh:path rdfc:endpoint;
                sh:name "endpoint";
                sh:minCount 1;
                sh:maxCount 1;
            ] , [
                sh:class rdfc:Writer;
                sh:path rdfc:writer;
                sh:name "writer";
                sh:minCount 0;
                sh:maxCount 1;
            ] , [
                sh:datatype xsd:string;
                sh:path rdfc:content_type;
                sh:name "content_type";
                sh:minCount 0;
                sh:maxCount 1;
            ]
        ] .


:HttpFetchConfigShape a sh:NodeShape;
    sh:targetClass tc:PipelineConfig;
    sh:property [
        sh:path rdfc:url;
        sh:name "url";
        sh:datatype xsd:string;
        sh:minCount 1;
    ], [
        sh:path rdfc:writer;
        sh:name "writer";
        sh:class rdfc:Writer;
        sh:maxCount 1;
        sh:minCount 0;
    ], [
        sh:path rdfc:options;
        sh:name "options";
        sh:class rdfc:HttpFetchOptions;
        sh:maxCount 1;
    ].


rdfc:LogProcessorPy a tc:PipelineComponent, rdfc:Processor;
    rdfs:label "Python Log Processor";
    dct:requires 
    [tc:component rdfc:PyRunner],
    [
        tc:component rdfc:Orchestrator ;
        tc:config [
            a tc:PipelineConfig ; 
            tc:embedded [ owl:imports <../../../usr/local/lib/python3.13/site-packages/rdfc_log_processor/processor.ttl> ]
        ];
    ] ;
    dcat:qualifiedRelation [
        dct:relation :LogProcessorPyConfigShape ;
        dcat:hadRole :configShape ; 
    ] . 


:LogProcessorPyConfigShape a sh:NodeShape;
    sh:targetClass tc:PipelineConfig;
    sh:property [
        sh:class rdfc:Reader;
        sh:path rdfc:reader;
        sh:name "reader";
        sh:minCount 0;
        sh:maxCount 1;
    ], [
        sh:class rdfc:Writer;
        sh:path rdfc:writer;
        sh:name "writer";
        sh:minCount 0;
        sh:maxCount 1;
    ], [
        sh:datatype xsd:string;
        sh:path rdfc:label;
        sh:name "label";
        sh:minCount 0;
        sh:maxCount 1;
    ], [
        sh:datatype xsd:string;
        sh:path rdfc:level;
        sh:name "level";
        sh:minCount 0;
        sh:maxCount 1;
    ], [
        sh:datatype xsd:boolean;
        sh:path rdfc:raw;
        sh:name "raw";
        sh:minCount 0;
        sh:maxCount 1;
    ] .



rdfc:NodeRunner a tc:PipelineComponent, rdfc:Runner;
    rdfs:label "RDF Connect Javascript Node Runner" ; 
    dct:requires 
    [
        tc:component rdfc:Orchestrator ;
        tc:config [
            a tc:PipelineConfig ; 
            tc:embedded [ owl:imports <./node_modules/@rdfc/js-runner/index.ttl> ]
        ];
    ] . 


rdfc:PyRunner a tc:PipelineComponent, rdfc:Runner;
    rdfs:label "RDF Connect Python Runner" ; 
    dct:requires 
    [
        tc:component rdfc:Orchestrator ;
        tc:config [
            a tc:PipelineConfig ; 
            tc:embedded [ owl:imports <../../../usr/local/lib/python3.13/site-packages/rdfc_runner/index.ttl> ]
        ];
    ] . 


rdfc:Orchestrator a tc:PipelineComponent ;
    rdfs:label "RDF Connect Orchestrator" ;
    tc:config [
        a tc:Config, tc:DefaultConfig, tc:DockerComposeConfig ;
        tc:literal """
  rdf-connect:
    container_name: rdf-connect
    image: rdf-connect:latest
    build: ../../resources/rdfc-docker
    volumes:
      - ./rdfc_pipeline.ttl:/workspace/pipeline/pipeline.ttl:ro
    environment:
      LOG_LEVEL: debug
    command: npx rdfc /workspace/pipeline/pipeline.ttl
"""
] .