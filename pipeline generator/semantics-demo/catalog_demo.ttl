@prefix : <http://example.org/example/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix demo: <http://example.org/example/semantics-demo/> .
@prefix ldio: <http://example.org/example/ldio/> .
@prefix nifi: <http://example.org/example/nifi/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix p-plan: <http://purl.org/net/p-plan#> .
@prefix proc: <http://dishacled.example.org/processors#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfc: <https://w3id.org/rdf-connect#> .
@prefix rdfl: <https://w3id.org/rdf-lens/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix sw: <https://semantic.works/services/> .
@prefix tcs: <https://w3id.org/toolchain#> .
@prefix tm: <https://w3id.org/rdf-connect/threshold-monitor#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:DishacledCatalog a dcat:Catalog,
        tcs:Catalog ;
    dct:title "Catalog of Pipeline Components" ;
    dcat:resource proc:JsonLdToNQuads,
        ldio:AmqpIn,
        ldio:AmqpOut,
        ldio:ChangeDetectionFilter,
        ldio:ConsoleOut,
        ldio:GeoJsonToWktTransformer,
        ldio:HttpEnricher,
        ldio:HttpIn,
        ldio:HttpInPoller,
        ldio:HttpOut,
        ldio:JsonToLdAdapter,
        ldio:KafkaIn,
        ldio:KafkaOut,
        ldio:LdesClient,
        ldio:LdesClientConnector,
        ldio:LdioPipelineStarterService,
        ldio:LinkedDataInteractionsOrchestrator,
        ldio:NgsiV2ToLdAdapter,
        ldio:RdfAdapter,
        ldio:RepositoryMaterialiser,
        ldio:RmlAdapter,
        ldio:SparqlConstructTransformer,
        ldio:VersionMaterialiser,
        ldio:VersionObjectCreator,
        nifi:AzureStorageCredentialsControllerService_v12,
        nifi:CreateVersionObjectProcessor,
        nifi:ExecuteGroovyScript,
        nifi:FetchAzureBlobStorage_v12,
        nifi:Funnel,
        nifi:GenerateFlowFile,
        nifi:InvokeHTTP,
        nifi:Orchestrator,
        nifi:SplitText,
        sw:deliver-email-service,
        sw:loket-error-alert-service,
        sw:mu-authorization,
        sw:mu-cl-resources,
        sw:mu-delta-notifier,
        sw:mu-dispatcher,
        sw:mu-identifier,
        sw:triple-store,
        rdfc:HttpFetch,
        rdfc:HttpIn,
        rdfc:HttpOut,
        rdfc:HttpServer,
        rdfc:LogProcessorJs,
        rdfc:LogProcessorPy,
        rdfc:NodeRunner,
        rdfc:Orchestrator,
        rdfc:PyRunner,
        rdfc:SPARQLIngest,
        rdfc:Sdsify,
        rdfc:SkolemizationProcessor,
        rdfc:thresholdMonitoringProcessor,
        tm:ThresholdMonitorJs .

demo:Log a tcs:InstancePipelineComponent ;
    p-plan:isPrecededBy demo:Parse ;
    p-plan:isStepOfPlan demo:SemanticsDemoPipeline ;
    prov:specializationOf rdfc:LogProcessorJs ;
    tcs:readsFrom _:N4db941bbb21f4d5eae375027a77d442c .

tcs:AcyclicGraphShape a sh:NodeShape ;
    rdfs:label "Acyclic channel graph shape" ;
    sh:message "Checks that no step transitively reads from a channel it also writes to (no cycles in the readsFrom/writesTo channel graph)." ;
    sh:sparql [ sh:message "Step {?this} is part of a cycle in the channel graph — it transitively reads from a channel it also writes to." ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this WHERE {\r
                ?this (tcs:writesTo/^tcs:readsFrom)+ ?this .\r
            }\r
        """ ] ;
    sh:targetClass tcs:InstancePipelineComponent .

tcs:BoundaryChannelTypeShape a sh:NodeShape ;
    rdfs:label "BoundaryChannelType application-profile shape" ;
    sh:message "Checks that a boundary component declares at most one tcs:channelType." ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A boundary component may declare at most one tcs:channelType." ;
            sh:name "channelType" ;
            sh:path tcs:channelType ] ;
    sh:targetClass tcs:EntryBoundaryComponent,
        tcs:ExitBoundaryComponent .

tcs:CatalogMissingBridgeShape a sh:NodeShape ;
    rdfs:label "CatalogMissingBridge application-profile shape" ;
    sh:message "Checks that every cross-container channel has a bridge step on both sides." ;
    sh:property [ sh:class tcs:ExitBoundaryComponent ;
            sh:message "Cross-container channel {?this} has no ExitBoundaryComponent-typed writer step — no bridge component available in the catalog to insert." ;
            sh:minCount 1 ;
            sh:name "exit-side-bridge" ;
            sh:path ( [ sh:inversePath tcs:writesTo ] prov:specializationOf ) ],
        [ sh:class tcs:EntryBoundaryComponent ;
            sh:message "Cross-container channel {?this} has no EntryBoundaryComponent-typed reader step — no bridge component available in the catalog to insert." ;
            sh:minCount 1 ;
            sh:name "entry-side-bridge" ;
            sh:path ( [ sh:inversePath tcs:readsFrom ] prov:specializationOf ) ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT DISTINCT ?this WHERE {\r
                ?this a tcs:Channel .\r
                ?writer tcs:writesTo ?this .\r
                ?reader tcs:readsFrom ?this .\r
                ?cW tcs:runs ?writer .\r
                ?cR tcs:runs ?reader .\r
                FILTER (?cW != ?cR)\r
            }\r
        """ ] .

tcs:CatalogShape a sh:NodeShape ;
    rdfs:label "Catalog application-profile shape" ;
    sh:message "Checks that every dcat:resource of a Catalog is a tcs:PipelineComponent." ;
    sh:property [ sh:class tcs:PipelineComponent ;
            sh:message "tcs:Catalog dcat:resource entries must be tcs:PipelineComponent instances." ;
            sh:name "resource" ;
            sh:path dcat:resource ] ;
    sh:targetClass tcs:Catalog .

tcs:ConfigShape a sh:NodeShape ;
    rdfs:label "Config application-profile shape" ;
    sh:message "Checks that a Config carries exactly one of tcs:embedded/tcs:literal, and that a tcs:literal body also declares dct:format." ;
    sh:sparql [ sh:message "Config {?this} uses tcs:literal but has no dct:format — the compiler cannot know how to parse the string body." ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this WHERE {\r
                ?this a tcs:Config ;\r
                      tcs:literal ?lit .\r
                FILTER NOT EXISTS { ?this dct:format ?fmt . }\r
            }\r
        """ ] ;
    sh:targetClass tcs:Config ;
    sh:xone ( [ sh:property [ sh:minCount 1 ;
                        sh:path tcs:embedded ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path tcs:literal ] ] ) .

tcs:DockerContainerShape a sh:NodeShape ;
    rdfs:label "DockerContainer application-profile shape" ;
    sh:message "Checks that a DockerContainer instantiates at least one PipelineComponent and that tcs:runs points at an InstancePipelineComponent." ;
    sh:property [ sh:class tcs:PipelineComponent ;
            sh:message "A DockerContainer must instantiate at least one tcs:PipelineComponent." ;
            sh:minCount 1 ;
            sh:name "instantiates" ;
            sh:path tcs:instantiates ],
        [ sh:class tcs:InstancePipelineComponent ;
            sh:message "tcs:runs must point at a tcs:InstancePipelineComponent." ;
            sh:name "runs" ;
            sh:path tcs:runs ] ;
    sh:targetClass tcs:DockerContainer .

tcs:InstancePipelineComponentShape a sh:NodeShape ;
    rdfs:label "InstancePipelineComponent application-profile shape" ;
    sh:message "Checks that a step belongs to exactly one PipelineDefinition, specializes exactly one PipelineComponent, has at most one hasInputVar, and that any readsFrom/writesTo point at a tcs:Channel." ;
    sh:property [ sh:class tcs:PipelineDefinition ;
            sh:maxCount 1 ;
            sh:message "Every step must belong to exactly one tcs:PipelineDefinition." ;
            sh:minCount 1 ;
            sh:name "isStepOfPlan" ;
            sh:path p-plan:isStepOfPlan ],
        [ sh:class tcs:PipelineComponent ;
            sh:maxCount 1 ;
            sh:message "Every step must specialize exactly one tcs:PipelineComponent." ;
            sh:minCount 1 ;
            sh:name "specializationOf" ;
            sh:path prov:specializationOf ],
        [ sh:class tcs:Config ;
            sh:maxCount 1 ;
            sh:message "A step may have at most one p-plan:hasInputVar — two configs on the same step silently merge their predicates (e.g. duplicate rdfc:level values) instead of composing with any defined precedence." ;
            sh:name "hasInputVar" ;
            sh:path p-plan:hasInputVar ],
        [ sh:class tcs:Channel ;
            sh:message "tcs:readsFrom must point at a tcs:Channel." ;
            sh:name "readsFrom" ;
            sh:path tcs:readsFrom ],
        [ sh:class tcs:Channel ;
            sh:message "tcs:writesTo must point at a tcs:Channel." ;
            sh:name "writesTo" ;
            sh:path tcs:writesTo ] ;
    sh:targetClass tcs:InstancePipelineComponent .

tcs:LdioComponentTypeShape a sh:NodeShape ;
    rdfs:label "LDIO component type shape" ;
    sh:message "Checks that every LDIO processing component declares exactly one ldio:type (Input/Adapter/Transformer/Output) and an rdfs:label." ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "Input" "Adapter" "Transformer" "Output" ) ;
            sh:maxCount 1 ;
            sh:message "LDIO component {?this} must declare exactly one ldio:type in {\"Input\", \"Adapter\", \"Transformer\", \"Output\"}." ;
            sh:minCount 1 ;
            sh:name "type" ;
            sh:path ldio:type ],
        [ sh:message "LDIO component {?this} must declare rdfs:label — LdioConfigCompiler uses it as the ``name:`` key in the emitted YAML pipeline." ;
            sh:minCount 1 ;
            sh:name "label" ;
            sh:path rdfs:label ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this WHERE {\r
                ?this a tcs:PipelineComponent ;\r
                      dct:requires ldio:LinkedDataInteractionsOrchestrator .\r
            }\r
        """ ] .

tcs:LdioSingularStepShape a sh:NodeShape ;
    rdfs:label "LDIO singular Input/Adapter shape" ;
    sh:message "Checks that a segment has at most one LDIO Input step and at most one LDIO Adapter step (LDIO's input:/input.adapter: YAML keys are singular)." ;
    sh:sparql [ sh:message "LDIO step {?this} is a second \"Input\" step in segment {?segment}, alongside {?other} — LDIO's input: key is singular, not a list; LdioConfigCompiler would silently drop one of them." ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this ?segment ?other WHERE {\r
                ?this a tcs:InstancePipelineComponent ;\r
                      tcs:segment ?segment ;\r
                      prov:specializationOf ?comp .\r
                ?comp ldio:type "Input" .\r
                ?other a tcs:InstancePipelineComponent ;\r
                       tcs:segment ?segment ;\r
                       prov:specializationOf ?ocomp .\r
                ?ocomp ldio:type "Input" .\r
                FILTER ( ?other != ?this )\r
            }\r
        """ ],
        [ sh:message "LDIO step {?this} is a second \"Adapter\" step in segment {?segment}, alongside {?other} — LDIO's input.adapter: key is singular, not a list; LdioConfigCompiler would silently drop one of them." ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this ?segment ?other WHERE {\r
                ?this a tcs:InstancePipelineComponent ;\r
                      tcs:segment ?segment ;\r
                      prov:specializationOf ?comp .\r
                ?comp ldio:type "Adapter" .\r
                ?other a tcs:InstancePipelineComponent ;\r
                       tcs:segment ?segment ;\r
                       prov:specializationOf ?ocomp .\r
                ?ocomp ldio:type "Adapter" .\r
                FILTER ( ?other != ?this )\r
            }\r
        """ ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this WHERE {\r
                ?this a tcs:InstancePipelineComponent ;\r
                      prov:specializationOf ?comp .\r
                ?comp ldio:type ?anytype .\r
            }\r
        """ ] .

tcs:LdioStepOrderingShape a sh:NodeShape ;
    rdfs:label "LDIO step ordering shape" ;
    sh:message "Checks that an LDIO Output step is terminal and an LDIO Input step is initial within its LDIO segment." ;
    sh:sparql [ sh:message "LDIO Output step {?this} is followed by another LDIO step ({?downstream}) via channel {?ch} — Output must be terminal within its LDIO segment." ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this ?ch ?downstream WHERE {\r
                ?this a tcs:InstancePipelineComponent ;\r
                      prov:specializationOf ?comp ;\r
                      tcs:writesTo ?ch .\r
                ?comp ldio:type "Output" .\r
                ?downstream tcs:readsFrom ?ch ;\r
                            prov:specializationOf ?dcomp .\r
                ?dcomp ldio:type ?danytype .\r
                FILTER ( ?downstream != ?this )\r
            }\r
        """ ],
        [ sh:message "LDIO Input step {?this} is preceded by another LDIO step ({?upstream}) via channel {?ch} — Input must be initial within its LDIO segment." ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this ?ch ?upstream WHERE {\r
                ?this a tcs:InstancePipelineComponent ;\r
                      prov:specializationOf ?comp ;\r
                      tcs:readsFrom ?ch .\r
                ?comp ldio:type "Input" .\r
                ?upstream tcs:writesTo ?ch ;\r
                          prov:specializationOf ?ucomp .\r
                ?ucomp ldio:type ?uanytype .\r
                FILTER ( ?upstream != ?this )\r
            }\r
        """ ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this WHERE {\r
                ?this a tcs:InstancePipelineComponent ;\r
                      prov:specializationOf ?comp .\r
                ?comp ldio:type ?anytype .\r
            }\r
        """ ] .

tcs:LdioStepSerialityShape a sh:NodeShape ;
    rdfs:label "LDIO step seriality shape" ;
    sh:message "Checks that every LDIO step has at most one upstream and one downstream channel (LDIO pipelines are strictly serial)." ;
    sh:property [ sh:maxCount 1 ;
            sh:message "LDIO step {?this} reads from more than one channel — LDIO pipelines are strictly serial (max 1 upstream)." ;
            sh:name "readsFrom" ;
            sh:path tcs:readsFrom ],
        [ sh:maxCount 1 ;
            sh:message "LDIO step {?this} writes to more than one channel — LDIO pipelines are strictly serial (max 1 downstream)." ;
            sh:name "writesTo" ;
            sh:path tcs:writesTo ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this WHERE {\r
                ?this a tcs:InstancePipelineComponent ;\r
                      prov:specializationOf ?comp .\r
                ?comp ldio:type ?anytype .\r
            }\r
        """ ] .

tcs:NifiCatalogMetadataShape a sh:NodeShape ;
    rdfs:label "NiFi catalog metadata shape" ;
    sh:message "NiFi component {?this} must provide complete metadata for its processor, funnel, or controller-service kind." ;
    sh:or ( [ sh:or ( [ sh:property [ sh:minCount 1 ;
                                    sh:path nifi:outgoingRelationship ] ] [ sh:property [ sh:minCount 1 ;
                                    sh:path nifi:autoTerminatedRelationship ] ] ) ;
                sh:property [ sh:datatype xsd:string ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:path nifi:processorType ],
                    [ sh:datatype xsd:string ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:path nifi:bundleGroup ],
                    [ sh:datatype xsd:string ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:path nifi:bundleArtifact ],
                    [ sh:datatype xsd:string ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:path nifi:bundleVersion ] ] [ sh:property [ sh:hasValue "FUNNEL" ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:path nifi:componentType ] ] [ sh:property [ sh:datatype xsd:string ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:path nifi:serviceApiBundleArtifact ],
                    [ sh:datatype xsd:string ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:path nifi:serviceApiBundleVersion ],
                    [ sh:datatype xsd:string ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:path nifi:controllerServiceType ],
                    [ sh:datatype xsd:string ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:path nifi:bundleGroup ],
                    [ sh:datatype xsd:string ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:path nifi:bundleArtifact ],
                    [ sh:datatype xsd:string ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:path nifi:bundleVersion ],
                    [ sh:datatype xsd:string ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:path nifi:serviceApiType ],
                    [ sh:datatype xsd:string ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:path nifi:serviceApiBundleGroup ] ] ) ;
    sh:sparql [ sh:message "NiFi component {?this} must describe exactly one kind: processor, controller service, or funnel." ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this WHERE {\r
                ?this dct:requires nifi:Orchestrator .\r
                OPTIONAL {\r
                    {\r
                        ?this nifi:processorType ?processorType .\r
                        BIND ("processor" AS ?kind)\r
                    }\r
                    UNION\r
                    {\r
                        ?this nifi:controllerServiceType ?serviceType .\r
                        BIND ("controller-service" AS ?kind)\r
                    }\r
                    UNION\r
                    {\r
                        ?this nifi:componentType "FUNNEL" .\r
                        BIND ("funnel" AS ?kind)\r
                    }\r
                }\r
            }\r
            GROUP BY ?this\r
            HAVING (COUNT(DISTINCT ?kind) != 1)\r
        """ ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this WHERE {\r
                ?this a tcs:PipelineComponent ;\r
                    dct:requires nifi:Orchestrator .\r
            }\r
        """ ] .

tcs:NifiChannelTopologyShape a sh:NodeShape ;
    rdfs:label "NiFi channel topology shape" ;
    sh:sparql [ sh:message "NiFi channel {?this} has more than one NiFi writer; explicit fan-in is not supported yet." ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT DISTINCT ?this WHERE {\r
                ?left tcs:writesTo ?this ;\r
                    prov:specializationOf ?leftComponent .\r
                ?right tcs:writesTo ?this ;\r
                    prov:specializationOf ?rightComponent .\r
                ?leftComponent dct:requires nifi:Orchestrator .\r
                ?rightComponent dct:requires nifi:Orchestrator .\r
                FILTER (?left != ?right)\r
            }\r
        """ ],
        [ sh:message "NiFi channel {?this} has more than one NiFi reader; explicit fan-out is not supported yet." ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT DISTINCT ?this WHERE {\r
                ?left tcs:readsFrom ?this ;\r
                    prov:specializationOf ?leftComponent .\r
                ?right tcs:readsFrom ?this ;\r
                    prov:specializationOf ?rightComponent .\r
                ?leftComponent dct:requires nifi:Orchestrator .\r
                ?rightComponent dct:requires nifi:Orchestrator .\r
                FILTER (?left != ?right)\r
            }\r
        """ ],
        [ sh:message "NiFi step {?step} reads from and writes to channel {?this}; self-loop channels are not supported by the compiler." ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT DISTINCT ?this ?step WHERE {\r
                ?step tcs:readsFrom ?this ;\r
                    tcs:writesTo ?this ;\r
                    prov:specializationOf ?component .\r
                ?component dct:requires nifi:Orchestrator .\r
            }\r
        """ ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT DISTINCT ?this WHERE {\r
                ?step (tcs:readsFrom|tcs:writesTo) ?this ;\r
                    prov:specializationOf ?component .\r
                ?component dct:requires nifi:Orchestrator .\r
            }\r
        """ ] .

tcs:NifiControllerServiceReferenceShape a sh:NodeShape ;
    rdfs:label "NiFi controller service reference shape" ;
    sh:sparql [ sh:message "NiFi step {?this} references {?referencedStep}, which is not a valid controller-service step." ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT DISTINCT ?this ?referencedStep WHERE {\r
                ?this prov:specializationOf ?component ;\r
                    p-plan:hasInputVar/tcs:embedded ?config .\r
                ?component dcat:qualifiedRelation/dct:relation/sh:property ?propertyShape .\r
                ?propertyShape sh:path ?predicate ;\r
                    sh:class tcs:InstancePipelineComponent .\r
                ?config ?predicate ?referencedStep .\r
                FILTER NOT EXISTS {\r
                    ?referencedStep a tcs:InstancePipelineComponent ;\r
                        prov:specializationOf ?serviceComponent .\r
                    ?serviceComponent nifi:controllerServiceType ?serviceType .\r
                }\r
            }\r
        """ ],
        [ sh:message "NiFi step {?this} and referenced controller service {?referencedStep} must belong to the same pipeline definition." ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT DISTINCT ?this ?referencedStep WHERE {\r
                ?this p-plan:isStepOfPlan ?plan ;\r
                    prov:specializationOf ?component ;\r
                    p-plan:hasInputVar/tcs:embedded ?config .\r
                ?component dcat:qualifiedRelation/dct:relation/sh:property ?propertyShape .\r
                ?propertyShape sh:path ?predicate ;\r
                    sh:class tcs:InstancePipelineComponent .\r
                ?config ?predicate ?referencedStep .\r
                FILTER NOT EXISTS { ?referencedStep p-plan:isStepOfPlan ?plan . }\r
            }\r
        """ ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT DISTINCT ?this WHERE {\r
                ?this a tcs:InstancePipelineComponent ;\r
                    prov:specializationOf ?component ;\r
                    p-plan:hasInputVar/tcs:embedded ?config .\r
                ?component dcat:qualifiedRelation/dct:relation/sh:property ?propertyShape .\r
                ?propertyShape sh:path ?predicate ;\r
                    sh:class tcs:InstancePipelineComponent .\r
                ?config ?predicate ?referencedStep .\r
            }\r
        """ ] .

tcs:NifiDeploymentModeShape a sh:NodeShape ;
    rdfs:label "NiFi deployment mode shape" ;
    sh:property [ sh:in ( "local" "remote" ) ;
            sh:maxCount 1 ;
            sh:message "nifi:deploymentMode must be either local or remote. Omit it to use local Docker." ;
            sh:path nifi:deploymentMode ] ;
    sh:sparql [ sh:message "Remote NiFi deployment requires exactly one nifi:deploymentConfig." ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this WHERE {\r
                ?this nifi:deploymentMode "remote" .\r
                {\r
                    FILTER NOT EXISTS { ?this nifi:deploymentConfig ?config . }\r
                }\r
                UNION\r
                {\r
                    ?this nifi:deploymentConfig ?left, ?right .\r
                    FILTER (?left != ?right)\r
                }\r
            }\r
        """ ] ;
    sh:targetClass tcs:PipelineDefinition .

tcs:NifiRouteShape a sh:NodeShape ;
    rdfs:label "NiFi route shape" ;
    sh:property [ sh:class tcs:Channel ;
            sh:maxCount 1 ;
            sh:message "A NiFi route must reference exactly one nifi:channel." ;
            sh:minCount 1 ;
            sh:path nifi:channel ],
        [ sh:datatype xsd:string ;
            sh:message "A NiFi route must select at least one relationship." ;
            sh:minCount 1 ;
            sh:path nifi:selectedRelationship ] ;
    sh:sparql [ sh:message "NiFi route {?this} references channel {?channel}, but its owner step does not write to that channel." ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT DISTINCT ?this ?channel WHERE {\r
                ?step p-plan:hasInputVar/tcs:embedded ?config .\r
                ?config nifi:route ?this .\r
                ?this nifi:channel ?channel .\r
                FILTER NOT EXISTS { ?step tcs:writesTo ?channel . }\r
            }\r
        """ ],
        [ sh:message "NiFi route {?this} selects relationship {?relationship}, which is not declared by its PipelineComponent." ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT DISTINCT ?this ?relationship WHERE {\r
                ?step prov:specializationOf ?component ;\r
                    p-plan:hasInputVar/tcs:embedded ?config .\r
                ?config nifi:route ?this .\r
                ?this nifi:selectedRelationship ?relationship .\r
                FILTER NOT EXISTS {\r
                    ?component\r
                        (nifi:outgoingRelationship|nifi:autoTerminatedRelationship)\r
                        ?relationship .\r
                }\r
            }\r
        """ ] ;
    sh:targetObjectsOf nifi:route .

tcs:NifiStepScheduledStateShape a sh:NodeShape ;
    rdfs:label "NiFi step scheduledState shape" ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "DISABLED" "ENABLED" "RUNNING" ) ;
            sh:maxCount 1 ;
            sh:message "nifi:scheduledState on {?this} must be one of DISABLED, ENABLED, RUNNING." ;
            sh:path nifi:scheduledState ] ;
    sh:sparql [ sh:message "NiFi processor {?this} must use scheduled state RUNNING or DISABLED." ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this WHERE {\r
                ?this prov:specializationOf ?component ;\r
                    nifi:scheduledState ?state .\r
                ?component nifi:processorType ?processorType .\r
                FILTER (?state NOT IN ("RUNNING", "DISABLED"))\r
            }\r
        """ ],
        [ sh:message "NiFi controller-service step {?this} must use scheduled state ENABLED or DISABLED." ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this WHERE {\r
                ?this prov:specializationOf ?component ;\r
                    nifi:scheduledState ?state .\r
                ?component nifi:controllerServiceType ?serviceType .\r
                FILTER (?state NOT IN ("ENABLED", "DISABLED"))\r
            }\r
        """ ],
        [ sh:message "NiFi funnel step {?this} must not declare nifi:scheduledState." ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this WHERE {\r
                ?this prov:specializationOf ?component ;\r
                    nifi:scheduledState ?state .\r
                ?component nifi:componentType "FUNNEL" .\r
            }\r
        """ ] ;
    sh:targetSubjectsOf nifi:scheduledState .

tcs:PipelineBuildShape a sh:NodeShape ;
    rdfs:label "PipelineBuild application-profile shape" ;
    sh:message "Checks that a PipelineBuild links to exactly one PipelineDefinition, and that dct:hasPart/tcs:compiledFile point at a DockerContainer/spdx:File respectively." ;
    sh:property [ sh:class tcs:PipelineDefinition ;
            sh:maxCount 1 ;
            sh:message "A PipelineBuild must be linked to exactly one PipelineDefinition via prov:hadPlan." ;
            sh:minCount 1 ;
            sh:name "hadPlan" ;
            sh:path prov:hadPlan ],
        [ sh:class tcs:DockerContainer ;
            sh:message "dct:hasPart on a PipelineBuild must point at a tcs:DockerContainer." ;
            sh:name "hasPart" ;
            sh:path dct:hasPart ],
        [ sh:class spdx:File ;
            sh:message "tcs:compiledFile must point at an spdx:File." ;
            sh:name "compiledFile" ;
            sh:path tcs:compiledFile ] ;
    sh:targetClass tcs:PipelineBuild .

tcs:PipelineComponentShape a sh:NodeShape ;
    rdfs:label "PipelineComponent application-profile shape" ;
    sh:message "Checks that a PipelineComponent's tcs:config/dct:requires are well-typed, it has at most one DefaultConfig per Config subtype, and it is transitively deployable via dct:requires+." ;
    sh:property [ sh:class tcs:Config ;
            sh:message "tcs:config must point at a tcs:Config." ;
            sh:name "config" ;
            sh:path tcs:config ],
        [ sh:message "dct:requires on a PipelineComponent must point at a tcs:PipelineComponent or spdx:Package." ;
            sh:name "requires" ;
            sh:or ( [ sh:class tcs:PipelineComponent ] [ sh:class spdx:Package ] ) ;
            sh:path dct:requires ] ;
    sh:sparql [ sh:message "PipelineComponent {?this} is not deployable: neither it nor any component reachable via dct:requires+ carries a tcs:DockerComposeConfig." ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this WHERE {\r
                ?this a tcs:PipelineComponent .\r
                FILTER NOT EXISTS {\r
                    ?this dct:requires* ?deployable .\r
                    ?deployable tcs:config ?cfg .\r
                    ?cfg a tcs:DockerComposeConfig .\r
                }\r
            }\r
        """ ],
        [ sh:message "PipelineComponent {?this} has more than one tcs:DefaultConfig of subtype {?subtype} — at most one default per Config subtype." ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT DISTINCT ?this ?subtype WHERE {\r
                ?this tcs:config ?d1, ?d2 .\r
                FILTER ( STR(?d1) < STR(?d2) )\r
                ?d1 a tcs:DefaultConfig, ?subtype .\r
                ?d2 a tcs:DefaultConfig, ?subtype .\r
                ?subtype rdfs:subClassOf tcs:Config .\r
                FILTER ( ?subtype != tcs:Config && ?subtype != tcs:DefaultConfig )\r
            }\r
        """ ] ;
    sh:targetClass tcs:PipelineComponent .

tcs:PipelineDefinitionShape a sh:NodeShape ;
    rdfs:label "PipelineDefinition application-profile shape" ;
    sh:message "Checks that a PipelineDefinition has at least one step referencing it via p-plan:isStepOfPlan." ;
    sh:sparql [ sh:message "PipelineDefinition {?this} has no steps — at least one tcs:InstancePipelineComponent must reference it via p-plan:isStepOfPlan." ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this WHERE {\r
                ?this a tcs:PipelineDefinition .\r
                FILTER NOT EXISTS { ?step p-plan:isStepOfPlan ?this . }\r
            }\r
        """ ] ;
    sh:targetClass tcs:PipelineDefinition .

tcs:PipelineGenerator rdfs:subClassOf prov:SoftwareAgent .

tcs:RdfcMandatoryReaderWiringShape a sh:NodeShape ;
    rdfs:label "RDF-Connect mandatory reader wiring shape" ;
    sh:property [ sh:message "{?this}'s component declares a mandatory rdfc:Reader config path but the step has no tcs:readsFrom wiring — it cannot run without one." ;
            sh:minCount 1 ;
            sh:name "readsFrom" ;
            sh:path tcs:readsFrom ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT DISTINCT ?this WHERE {\r
                ?this a tcs:InstancePipelineComponent ;\r
                      prov:specializationOf ?component .\r
                ?component dcat:qualifiedRelation ?rel .\r
                ?rel dcat:hadRole tcs:configShape ;\r
                     dct:relation ?shape .\r
                ?shape sh:property ?prop .\r
                ?prop sh:class tcs:Channel ;\r
                      tcs:upstreamClass rdfc:Reader ;\r
                      tcs:upstreamMinCount ?minCount .\r
                FILTER (?minCount >= 1)\r
            }\r
        """ ] .

tcs:RdfcMandatoryWriterWiringShape a sh:NodeShape ;
    rdfs:label "RDF-Connect mandatory writer wiring shape" ;
    sh:property [ sh:message "{?this}'s component declares a mandatory rdfc:Writer config path but the step has no tcs:writesTo wiring — it cannot run without one." ;
            sh:minCount 1 ;
            sh:name "writesTo" ;
            sh:path tcs:writesTo ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT DISTINCT ?this WHERE {\r
                ?this a tcs:InstancePipelineComponent ;\r
                      prov:specializationOf ?component .\r
                ?component dcat:qualifiedRelation ?rel .\r
                ?rel dcat:hadRole tcs:configShape ;\r
                     dct:relation ?shape .\r
                ?shape sh:property ?prop .\r
                ?prop sh:class tcs:Channel ;\r
                      tcs:upstreamClass rdfc:Writer ;\r
                      tcs:upstreamMinCount ?minCount .\r
                FILTER (?minCount >= 1)\r
            }\r
        """ ] .

tcs:RdfcOrchestratorConfigShape a sh:NodeShape ;
    rdfs:label "RDF-Connect orchestrator config shape" ;
    sh:sparql [ sh:message "rdfc:Orchestrator must carry at least one tcs:DockerComposeConfig — without it the compose aggregator cannot start the container." ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this WHERE {\r
                FILTER NOT EXISTS {\r
                    ?this tcs:config ?cfg .\r
                    ?cfg a tcs:DockerComposeConfig .\r
                }\r
            }\r
        """ ],
        [ sh:message "rdfc:Orchestrator must carry at least one tcs:DockerImageConfig — without it RdfcDockerFileCompiler cannot emit a Dockerfile for the RDFC container." ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this WHERE {\r
                FILTER NOT EXISTS {\r
                    ?this tcs:config ?cfg .\r
                    ?cfg a tcs:DockerImageConfig .\r
                }\r
            }\r
        """ ] ;
    sh:targetNode rdfc:Orchestrator .

tcs:RdfcPackageManagerShape a sh:NodeShape ;
    rdfs:label "RDF-Connect package manager shape" ;
    sh:property [ sh:in ( :pip :npm ) ;
            sh:message "spdx:Package {?this} is part of the RDF-Connect dependency closure; its spdx:suppliedBy must be :pip or :npm so RdfcDockerFileCompiler can route it to pyproject.toml or package.json." ;
            sh:name "suppliedBy" ;
            sh:path spdx:suppliedBy ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this WHERE {\r
                ?this a spdx:Package .\r
                ?owner dct:requires ?this ;\r
                       dct:requires* rdfc:Orchestrator .\r
            }\r
        """ ] .

tcs:RdfcProcessorShape a sh:NodeShape ;
    rdfs:label "RDF-Connect processor shape" ;
    sh:property [ sh:message "RDF-Connect processor {?this} must declare owl:imports pointing at its processor.ttl — otherwise the runner cannot locate the processor definition at startup." ;
            sh:minCount 1 ;
            sh:name "imports" ;
            sh:path owl:imports ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this WHERE {\r
                ?this a tcs:PipelineComponent ;\r
                      dct:requires ?runner .\r
                ?runner a rdfc:Runner .\r
            }\r
        """ ] .

tcs:RdfcRunnerShape a sh:NodeShape ;
    rdfs:label "RDF-Connect runner shape" ;
    sh:property [ sh:hasValue rdfc:Orchestrator ;
            sh:message "rdfc:Runner {?this} must dct:requires rdfc:Orchestrator — the compiler needs the link to place processors inside the runner's env." ;
            sh:name "requires-orchestrator" ;
            sh:path dct:requires ] ;
    sh:targetClass rdfc:Runner .

tcs:RdfcStepChannelWiringShape a sh:NodeShape ;
    rdfs:label "RDF-Connect step channel wiring shape" ;
    sh:sparql [ sh:message "Step {?this} reads from {?value} according to its config, but does not declare tcs:readsFrom {?value}. The framework-specific wiring and the framework-neutral annotation disagree." ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this ?value WHERE {\r
                ?this tcs:derivedReadsFrom ?value .\r
                FILTER NOT EXISTS { ?this tcs:readsFrom ?value . }\r
            }\r
        """ ],
        [ sh:message "Step {?this} writes to {?value} according to its config, but does not declare tcs:writesTo {?value}. The framework-specific wiring and the framework-neutral annotation disagree." ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this ?value WHERE {\r
                ?this tcs:derivedWritesTo ?value .\r
                FILTER NOT EXISTS { ?this tcs:writesTo ?value . }\r
            }\r
        """ ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this WHERE {\r
                ?this a tcs:InstancePipelineComponent ;\r
                      prov:specializationOf ?component .\r
                ?component a rdfc:Processor .\r
            }\r
        """ ] .

tcs:SecretReferenceShape a sh:NodeShape ;
    rdfs:label "Secret reference application-profile shape" ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "tcs:secretName must be a non-empty environment-variable name using letters, digits, and underscores." ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:name "secret name" ;
            sh:path tcs:secretName ;
            sh:pattern "^[A-Za-z_][A-Za-z0-9_]*$" ] ;
    sh:targetClass tcs:SecretReference .

tcs:SparqlUpdateChannel rdfs:subClassOf tcs:HttpChannel .

tcs:SpdxPackageShape a sh:NodeShape ;
    rdfs:label "spdx:Package application-profile shape" ;
    sh:message "Checks that an spdx:Package declares both spdx:name and an IRI spdx:suppliedBy, needed to emit it into pyproject.toml/package.json." ;
    sh:property [ sh:message "spdx:Package must declare spdx:name — required for pyproject.toml / package.json emission." ;
            sh:minCount 1 ;
            sh:name "name" ;
            sh:path spdx:name ],
        [ sh:message "spdx:Package must declare spdx:suppliedBy (an IRI) — the pipeline generator routes packages to the right manifest file based on this value." ;
            sh:minCount 1 ;
            sh:name "suppliedBy" ;
            sh:nodeKind sh:IRI ;
            sh:path spdx:suppliedBy ] ;
    sh:targetClass spdx:Package .

tcs:SpecializedComponentIsCatalogedShape a sh:NodeShape ;
    rdfs:label "Specialized component is catalogued shape" ;
    sh:message "Checks that every step's specialized component is listed as a dcat:resource of some tcs:Catalog." ;
    sh:sparql [ sh:message "Step {?this} specializes {?component}, which is not listed as a dcat:resource of any tcs:Catalog — likely an undefined or mistyped component reference." ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this ?component WHERE {\r
                ?this a tcs:InstancePipelineComponent ;\r
                      prov:specializationOf ?component .\r
                FILTER NOT EXISTS {\r
                    ?catalog a tcs:Catalog ;\r
                             dcat:resource ?component .\r
                }\r
            }\r
        """ ] ;
    sh:targetClass tcs:InstancePipelineComponent .

tcs:SwComponentDockerConfigShape a sh:NodeShape ;
    rdfs:label "Semantic.works component DockerComposeConfig shape" ;
    sh:message "Checks that every semantic.works component directly carries a tcs:DockerComposeConfig." ;
    sh:sparql [ sh:message "Semantic.works component {?this} must directly carry a tcs:DockerComposeConfig via tcs:config — the compiler needs it to fold env vars into." ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this WHERE {\r
                FILTER NOT EXISTS {\r
                    ?this tcs:config ?dc .\r
                    ?dc a tcs:DockerComposeConfig .\r
                }\r
            }\r
        """ ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this WHERE {\r
                ?this a tcs:PipelineComponent .\r
                FILTER ( STRSTARTS(STR(?this), "https://semantic.works/services/") )\r
            }\r
        """ ] .

tcs:SwSingleInstanceShape a sh:NodeShape ;
    rdfs:label "Semantic.works single-instance shape" ;
    sh:message "Checks that no semantic.works component is specialized by more than one InstancePipelineComponent." ;
    sh:sparql [ sh:message "Step {?this} specializes semantic.works component {?comp}, which is also specialized by {?other} — semantic.works components are single-tenant microservices and must not be instanced more than once." ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this ?comp ?other WHERE {\r
                ?this a tcs:InstancePipelineComponent ;\r
                      prov:specializationOf ?comp .\r
                ?other a tcs:InstancePipelineComponent ;\r
                       prov:specializationOf ?comp .\r
                FILTER ( ?other != ?this )\r
            }\r
        """ ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT DISTINCT ?this WHERE {\r
                ?this a tcs:InstancePipelineComponent ;\r
                      prov:specializationOf ?comp .\r
                FILTER ( STRSTARTS(STR(?comp), "https://semantic.works/services/") )\r
            }\r
        """ ] .

tcs:SwStepEnvValueShape a sh:NodeShape ;
    rdfs:label "Semantic.works step env-value literal shape" ;
    sh:message "Checks that semantic.works step config values are RDF literals, not IRIs or blank nodes." ;
    sh:sparql [ sh:message "Semantic.works step config {?this} has non-literal value at predicate {?p} — docker-compose environment values must be scalars, not IRIs or blank nodes." ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this ?p WHERE {\r
                ?this ?p ?v .\r
                FILTER ( ?p != rdf:type && !isLiteral(?v) )\r
            }\r
        """ ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this WHERE {\r
                ?step a tcs:InstancePipelineComponent ;\r
                      prov:specializationOf ?comp ;\r
                      p-plan:hasInputVar/tcs:embedded ?this .\r
                FILTER ( STRSTARTS(STR(?comp), "https://semantic.works/services/") )\r
            }\r
        """ ] .

tcs:UnsupportedChannelTopologyShape a sh:NodeShape ;
    rdfs:label "UnsupportedChannelTopology application-profile shape" ;
    sh:message "Checks that cross-container channel topology is a MVP-supported (1-writer, 1-or-2-container) shape." ;
    sh:sparql [ sh:message "Channel {?this} has writers in more than one container — multi-container fan-in is not auto-bridged." ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this WHERE {\r
                ?this a tcs:Channel .\r
                ?writer tcs:writesTo ?this .\r
                ?container tcs:runs ?writer .\r
            }\r
            GROUP BY ?this\r
            HAVING (COUNT(DISTINCT ?container) > 1)\r
        """ ],
        [ sh:message "Channel {?this} has readers spanning more than two containers total — multi-container fan-out is not auto-bridged." ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this WHERE {\r
                ?this a tcs:Channel .\r
                {\r
                    ?reader tcs:readsFrom ?this .\r
                    ?container tcs:runs ?reader .\r
                }\r
                UNION\r
                {\r
                    ?writer tcs:writesTo ?this .\r
                    ?container tcs:runs ?writer .\r
                }\r
            }\r
            GROUP BY ?this\r
            HAVING (COUNT(DISTINCT ?container) > 2)\r
        """ ] ;
    sh:targetClass tcs:Channel .

proc:JsonLdToNQuads a dcat:Resource,
        rdfc:Processor,
        tcs:PipelineComponent ;
    rdfs:label "JSON-LD to N-Quads processor" ;
    dct:requires [ a spdx:Package ;
            spdx:downloadLocation "file:///workspace/pipeline/processors/jsonld-to-nquads" ;
            spdx:name "jsonld-to-nquads" ;
            spdx:suppliedBy :npm ],
        [ a spdx:Package ;
            spdx:name "jsonld" ;
            spdx:suppliedBy :npm ;
            spdx:versionInfo "^9.0.0" ],
        rdfc:NodeRunner ;
    rdfs:description "Parses incoming JSON-LD strings and serializes them as N-Quads for downstream RDF processors." ;
    owl:imports <file:///workspace/pipeline/processors/jsonld-to-nquads/processor.ttl> ;
    dcat:qualifiedRelation [ a dcat:Relationship ;
            dct:relation :JsonLdToNQuadsShape ;
            dcat:hadRole tcs:configShape ],
        [ a dcat:Relationship ;
            dct:relation [ a sh:NodeShape ] ;
            dcat:hadRole tcs:passthroughShape ] .

:ChangeSemanticsShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "changeTypePath" ;
            sh:path rdfc:changeTypePath ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "createValue" ;
            sh:path rdfc:createValue ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "deleteValue" ;
            sh:path rdfc:deleteValue ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "updateValue" ;
            sh:path rdfc:updateValue ] ;
    sh:targetObjectsOf rdfc:changeSemantics .

:HttpFetchAuthShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "type" ;
            sh:path rdfc:type ] ;
    sh:targetObjectsOf rdfc:HttpFetchAuth .

:HttpFetchOptionsShape a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:name "auth" ;
            sh:node :HttpFetchAuthShape ;
            sh:path rdfc:HttpFetchAuth ],
        [ sh:datatype xsd:string ;
            sh:name "acceptStatusCodes" ;
            sh:path rdfc:acceptStatusCodes ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:name "closeOnEnd" ;
            sh:path rdfc:closeOnEnd ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "cron" ;
            sh:path rdfc:cron ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:name "errorsAreFatal" ;
            sh:path rdfc:errorsAreFatal ],
        [ sh:datatype xsd:string ;
            sh:name "headers" ;
            sh:path rdfc:headers ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "method" ;
            sh:path rdfc:method ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:name "outputAsBuffer" ;
            sh:path rdfc:outputAsBuffer ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:name "outputAsStream" ;
            sh:path rdfc:outputAsStream ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:name "runOnInit" ;
            sh:path rdfc:runOnInit ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:name "timeOutMilliseconds" ;
            sh:path rdfc:timeOutMilliseconds ] ;
    sh:targetObjectsOf rdfc:options .

:HttpFetchShape a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:name "options" ;
            sh:node :HttpFetchOptionsShape ;
            sh:path rdfc:options ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:name "url" ;
            sh:path rdfc:url ],
        [ sh:class tcs:Channel ;
            sh:maxCount 1 ;
            sh:name "writer" ;
            sh:path rdfc:writer ;
            tcs:upstreamClass rdfc:Writer ;
            tcs:upstreamMinCount 1 ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this WHERE {\r
                ?step prov:specializationOf rdfc:HttpFetch ;\r
                      p-plan:hasInputVar/tcs:embedded ?this .\r
            }\r
        """ ] .

:HttpOutShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:name "content_type" ;
            sh:path rdfc:content_type ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "endpoint" ;
            sh:path rdfc:endpoint ],
        [ sh:class tcs:Channel ;
            sh:maxCount 1 ;
            sh:name "reader" ;
            sh:path rdfc:reader ;
            tcs:upstreamClass rdfc:Reader ;
            tcs:upstreamMinCount 1 ],
        [ sh:class tcs:Channel ;
            sh:maxCount 1 ;
            sh:name "writer" ;
            sh:path rdfc:writer ;
            tcs:upstreamClass rdfc:Writer ;
            tcs:upstreamMinCount 0 ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this WHERE {\r
                ?step prov:specializationOf rdfc:HttpOut ;\r
                      p-plan:hasInputVar/tcs:embedded ?this .\r
            }\r
        """ ] .

:HttpServerOptionsShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "host" ;
            sh:path rdfc:host ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "method" ;
            sh:path rdfc:method ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "path" ;
            sh:path rdfc:path ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:name "streamThresholdBytes" ;
            sh:path rdfc:streamThresholdBytes ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:name "successStatusCode" ;
            sh:path rdfc:successStatusCode ] ;
    sh:targetObjectsOf rdfc:options .

:HttpServerShape a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:name "options" ;
            sh:node :HttpServerOptionsShape ;
            sh:path rdfc:options ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "port" ;
            sh:path rdfc:port ],
        [ sh:class tcs:Channel ;
            sh:maxCount 1 ;
            sh:name "writer" ;
            sh:path rdfc:writer ;
            tcs:upstreamClass rdfc:Writer ;
            tcs:upstreamMinCount 1 ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:prefixes tcs:prefixes ;
            sh:select """\r
            SELECT ?this WHERE {\r
                ?step prov:specializationOf rdfc:HttpServer ;\r
                      p-plan:hasInputVar/tcs:embedded ?this .\r
            }\r
        """ ] .

:IngestConfigShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:name "accessToken" ;
            sh:path rdfc:accessToken ],
        [ sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:name "changeSemantics" ;
            sh:node :ChangeSemanticsShape ;
            sh:path rdfc:changeSemantics ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:name "forVirtuoso" ;
            sh:path rdfc:forVirtuoso ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:name "graphStoreUrl" ;
            sh:path rdfc:graphStoreUrl ],
        [ sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:name "measurePerformance" ;
            sh:node :PerformanceConfigShape ;
            sh:path rdfc:measurePerformance ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:name "memberBatchSize" ;
            sh:path rdfc:memberBatchSize ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "memberShape" ;
            sh:path rdfc:memberShape ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "operationMode" ;
            sh:path rdfc:operationMode ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:name "targetNamedGraph" ;
            sh:path rdfc:targetNamedGraph ],
        [ sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:name "transactionConfig" ;
            sh:node :TransactionConfigShape ;
            sh:path rdfc:transactionConfig ] ;
    sh:targetObjectsOf rdfc:ingestConfig .

:JsonLdToNQuadsShape a sh:NodeShape ;
    sh:property [ sh:class tcs:Channel ;
            sh:maxCount 1 ;
            sh:name "reader" ;
            sh:path rdfc:reader ;
            tcs:upstreamClass rdfc:Reader ;
            tcs:upstreamMinCount 1 ],
        [ sh:class tcs:Channel ;
            sh:maxCount 1 ;
            sh:name "writer" ;
            sh:path rdfc:writer ;
            tcs:upstreamClass rdfc:Writer ;
            tcs:upstreamMinCount 1 ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:select """\r
            SELECT ?this WHERE {\r
                ?step <http://www.w3.org/ns/prov#specializationOf>\r
                          <http://dishacled.example.org/processors#JsonLdToNQuads> ;\r
                      <http://purl.org/net/p-plan#hasInputVar>/<https://w3id.org/toolchain#embedded>\r
                          ?this .\r
            }\r
        """ ] .

