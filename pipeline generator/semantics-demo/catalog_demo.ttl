        [ sh:maxCount 1 ;
            sh:name "shapeIri" ;
            sh:nodeKind sh:IRI ;
            sh:path rdfc:shapeIri ;
            tcs:upstreamDatatype xsd:iri ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
