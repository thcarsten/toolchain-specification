@prefix : <http://example.org/example/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/>.
@prefix ldio: <http://example.org/example/ldio/> .
@prefix mu: <http://mu.semte.ch/vocabularies/core/>.
@prefix nfo: <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#>.
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix p-plan: <http://purl.org/net/p-plan#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfc: <https://w3id.org/rdf-connect#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix sw: <https://semantic.works/services/> .
@prefix tcs: <https://w3id.org/toolchain#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .


# Here I define how the threshold monitoring processor is used in the demonstrator pipeline. It is preceded by an HTTP input step, and it uses the CentimeterConfig.
:ThresholdMonitoring  a tcs:InstancePipelineComponent ;
    prov:specializationOf rdfc:thresholdMonitoringProcessor ;
    p-plan:isStepOfPlan :DemonstratorPipeline ;
    p-plan:isPrecededBy :HttpIn ;
      p-plan:hasInputVar :CentimeterConfig .

# Here I define the threshold monitoring processor itself. It requires the NodeRunner component and the @rdfc/js-threshold-monitoring package, and it has several Configs as reusable templates attached to it.
rdfc:thresholdMonitoringProcessor a tcs:PipelineComponent;
    rdfs:label "RDF Connect Threshold Monitoring Processor" ; 
    dct:requires rdfc:NodeRunner ;
    dct:requires [
        a spdx:Package ;
        spdx:name "@rdfc/js-threshold-monitoring" ; # This is a mockup
        spdx:versionInfo "^3.0.2" ;
        spdx:suppliedBy :npm
    ];
    tcs:config :CentimeterConfig, :MillimeterConfig .
    dcat:qualifiedRelation 
    [
        a dcat:Relationship ;
        dcat:relation :ThresholdConfigShape ;
        dcat:role "configShape" 
    ] .    
        
# Here I define the expected shape of the configuration for the threshold monitoring processor. It requires exactly one rdfc:value of type xsd:integer and exactly one rdfc:unit, which can be either an IRI or a string literal.
:ThresholdConfigShape a sh:NodeShape ;
    # Target every node that appears as the object of tcs:embedded
    sh:targetObjectsOf tcs:embedded ;

    sh:property [
        sh:path rdfc:value ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "value" ;
        sh:message "Exactly one rdfc:value of type xsd:integer is required."
    ] ;
    sh:property [
        sh:path rdfc:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "unit" ;
        sh:message "Exactly one rdfc:unit is required; must be an IRI or a string literal." ;
        sh:or (
            [ sh:nodeKind sh:IRI ]
            [ sh:datatype xsd:string ]
        )
    ] .

# Here I declare that using this Config requires validating the CentimeterInputShape
:CentimeterConfig a tcs:PipelineConfig ; 
    tcs:embedded
    [
      rdfc:value 30 ;
      rdfc:unit <http://qudt.org/vocab/unit/CentiM>
    ] ;
    dcat:qualifiedRelation 
    [
        a dcat:Relationship ;
        dcat:relation :CentimeterInputShape ;
        dcat:role "inputShape" 
    ] .  

# This shape declares that the input data must have rdfc:unit <http://qudt.org/vocab/unit/CentiM> in order to be valid for this configuration.
:CentimeterInputShape a sh:NodeShape ;
    sh:property [
        sh:path rdfc:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM> ;
        sh:minCount 1 ;
        sh:message "Data must have rdfc:unit <http://qudt.org/vocab/unit/CentiM>."
    ] .